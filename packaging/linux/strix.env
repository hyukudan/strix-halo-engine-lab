# Environment of strix.service (systemd EnvironmentFile). Edit, then: systemctl restart strix
# STRIX_MODEL: first GGUF part of the model; the strix user must be able to read it (e.g. under /var/lib/strix).
STRIX_MODEL=/var/lib/strix/models/model.gguf
# Extra arguments after the serve config, split on spaces (e.g. --http-port 9000).
STRIX_SERVE_ARGS=
