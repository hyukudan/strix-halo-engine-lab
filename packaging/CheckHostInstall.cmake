file(STRINGS "${install_script}" install_lines)
set(in_core FALSE)
foreach(line IN LISTS install_lines)
    if(line MATCHES "^if\\(CMAKE_INSTALL_COMPONENT STREQUAL \"([^\"]+)\"")
        if(CMAKE_MATCH_1 STREQUAL "core")
            set(in_core TRUE)
        else()
            set(in_core FALSE)
        endif()
    elseif(in_core AND line MATCHES "file\\(INSTALL .* TYPE EXECUTABLE FILES \"([^\"]+)\"")
        get_filename_component(name "${CMAKE_MATCH_1}" NAME)
        if(name STREQUAL executable)
            return()
        endif()
    endif()
endforeach()
message(FATAL_ERROR "${executable} has no executable install rule in the host core component")
