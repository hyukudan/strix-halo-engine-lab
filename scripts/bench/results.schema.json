{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public engine benchmark results",
  "type": "object",
  "required": [
    "schema_version",
    "kit_version",
    "repo_commit",
    "engine",
    "identity",
    "identity_sha256",
    "status",
    "hardware",
    "prompts",
    "measurements",
    "exactness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kit_version": {
      "type": "string"
    },
    "repo_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Adapter name; an open set, so a new engine adapter needs no schema change."
    },
    "identity": {
      "type": "object"
    },
    "identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "mismatch"
      ]
    },
    "hardware": {
      "type": "object"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tokens",
          "sha256",
          "construction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "construction": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "mode",
          "unit",
          "repeat_count",
          "samples",
          "median",
          "min",
          "max"
        ],
        "properties": {
          "unit": {
            "enum": [
              "s",
              "tok/s"
            ]
          },
          "repeat_count": {
            "type": "integer",
            "minimum": 1
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "median": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timing_scope": {
            "enum": [
              "native",
              "http-end-to-end"
            ]
          },
          "tpot_scope": {
            "const": "per-token-request-mean"
          },
          "draft": {
            "$ref": "#/$defs/draft"
          },
          "route": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "exactness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "mode",
          "generate_length",
          "actual_tokens",
          "prompt_sha256",
          "token_ids_sha256",
          "engine_digest",
          "repeat_stable",
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "EXACT",
              "MISMATCH",
              "NO-REFERENCE"
            ]
          },
          "prompt_sha256": {
            "$ref": "#/$defs/hash"
          },
          "token_ids_sha256": {
            "$ref": "#/$defs/hash"
          },
          "engine_digest": {
            "type": [
              "object",
              "null"
            ]
          },
          "repeat_stable": {
            "type": "boolean"
          },
          "reference_found": {
            "type": "boolean",
            "description": "False keeps the verdict NO-REFERENCE or MISMATCH; EXACT requires true."
          },
          "plain_tokens_equal": {
            "type": "boolean"
          },
          "evidence_scope": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ids",
                "logits",
                "state"
              ]
            }
          },
          "draft": {
            "$ref": "#/$defs/draft"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "EXACT"
                }
              }
            },
            "then": {
              "required": [
                "reference_found"
              ],
              "properties": {
                "reference_found": {
                  "const": true
                },
                "repeat_stable": {
                  "const": true
                },
                "plain_tokens_equal": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "NO-REFERENCE"
                }
              }
            },
            "then": {
              "properties": {
                "reference_found": {
                  "const": false
                },
                "repeat_stable": {
                  "const": true
                },
                "plain_tokens_equal": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "contains": {
                    "const": "logits"
                  }
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "engine_digest": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "contains": {
                    "const": "state"
                  }
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "engine_digest": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          }
        ]
      }
    },
    "reference_sha256": {
      "$ref": "#/$defs/hash"
    },
    "reference_key": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "qwen"
          }
        }
      },
      "then": {
        "properties": {
          "measurements": {
            "items": {
              "properties": {
                "route": {
                  "properties": {
                    "claimed": {
                      "required": [
                        "pinned_T"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "draft": {
      "type": "object",
      "required": [
        "role",
        "status",
        "proposed",
        "verified",
        "accepted"
      ],
      "description": "Draft work of one cell: proposed drafts, verify cycles, accepted drafts. Cost-declined cells are no-draft, low-acceptance cells declined, absent counters unwitnessed.",
      "properties": {
        "role": {
          "enum": [
            "positive-control",
            "observed"
          ]
        },
        "status": {
          "enum": [
            "drafted",
            "no-draft",
            "declined",
            "unwitnessed"
          ]
        },
        "proposed": {
          "$ref": "#/$defs/count"
        },
        "verified": {
          "$ref": "#/$defs/count"
        },
        "accepted": {
          "$ref": "#/$defs/count"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "positive-control"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "drafted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "drafted"
              }
            }
          },
          "then": {
            "properties": {
              "proposed": {
                "type": "integer",
                "minimum": 1
              },
              "verified": {
                "type": "integer",
                "minimum": 1
              },
              "accepted": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unwitnessed"
              }
            }
          },
          "then": {
            "properties": {
              "proposed": {
                "type": "null"
              },
              "verified": {
                "type": "null"
              },
              "accepted": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "required": [
        "label",
        "status",
        "T",
        "cache_policy",
        "claimed"
      ],
      "description": "Resolved serving route of an HTTP cell: T from the startup serve-prefill line, cache policy from /v1/capabilities. Claims (pinned or inspected T, requested cache policy) must equal what the server reported; Qwen cells always pin T because its --http-serve requires the tiled MTP route.",
      "properties": {
        "label": {
          "enum": [
            "default"
          ]
        },
        "status": {
          "enum": [
            "read",
            "unread"
          ]
        },
        "T": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "T_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "cache_policy_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed": {
          "type": "object",
          "properties": {
            "pinned_T": {
              "type": "integer"
            },
            "inspected_T": {
              "type": "integer"
            },
            "cache_requested": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "T": {
                "type": "integer"
              },
              "cache_policy": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
