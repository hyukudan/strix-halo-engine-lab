{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public engine benchmark results",
  "type": "object",
  "required": [
    "schema_version",
    "kit_version",
    "repo_commit",
    "engine",
    "identity",
    "identity_sha256",
    "status",
    "hardware",
    "prompts",
    "measurements",
    "exactness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kit_version": {
      "type": "string"
    },
    "repo_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine": {
      "enum": [
        "qwen",
        "deepseek-pair",
        "deepseek-rtx",
        "glm-pair",
        "minimax-pair",
        "nemotron"
      ]
    },
    "identity": {
      "type": "object"
    },
    "identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "mismatch"
      ]
    },
    "hardware": {
      "type": "object"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tokens",
          "sha256",
          "construction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "construction": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "mode",
          "unit",
          "repeat_count",
          "samples",
          "median",
          "min",
          "max"
        ],
        "properties": {
          "unit": {
            "enum": [
              "s",
              "tok/s"
            ]
          },
          "repeat_count": {
            "type": "integer",
            "minimum": 1
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "median": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "exactness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "mode",
          "generate_length",
          "actual_tokens",
          "prompt_sha256",
          "token_ids_sha256",
          "engine_digest",
          "repeat_stable",
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "EXACT",
              "MISMATCH",
              "NO-REFERENCE"
            ]
          },
          "prompt_sha256": {
            "$ref": "#/$defs/hash"
          },
          "token_ids_sha256": {
            "$ref": "#/$defs/hash"
          },
          "engine_digest": {
            "type": [
              "object",
              "null"
            ]
          },
          "repeat_stable": {
            "type": "boolean"
          },
          "draft_witness": {
            "type": "object",
            "required": [
              "status",
              "drafted",
              "verified",
              "accepted"
            ],
            "properties": {
              "status": {
                "enum": [
                  "drafted",
                  "declined"
                ]
              },
              "drafted": {
                "type": "integer",
                "minimum": 0
              },
              "verified": {
                "type": "integer",
                "minimum": 0
              },
              "accepted": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "plain_tokens_equal": {
            "type": "boolean"
          },
          "plain_state_equal": {
            "type": "boolean"
          },
          "c1_equal": {
            "type": "boolean"
          }
        }
      }
    },
    "reference_sha256": {
      "$ref": "#/$defs/hash"
    },
    "reference_key": {
      "type": "object"
    },
    "digest_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "identity",
          "kv",
          "verdict"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "kv": {
            "$ref": "#/$defs/hash"
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "enum": [
              "EXACT",
              "MISMATCH",
              "NO-REFERENCE"
            ]
          }
        }
      }
    },
    "public_campaign": {
      "type": "object",
      "required": [
        "issue",
        "requested_tier",
        "native_tier",
        "groups",
        "group_measurements",
        "commands",
        "raw_samples",
        "native_manifests"
      ],
      "properties": {
        "issue": {
          "const": 116
        },
        "requested_tier": {
          "enum": [
            "exact",
            "fast",
            "turbo"
          ]
        },
        "native_tier": {
          "enum": [
            "exact",
            "fast"
          ]
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "group_measurements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "job",
              "rank",
              "argv"
            ],
            "properties": {
              "job": {
                "type": "string"
              },
              "rank": {
                "enum": [
                  0,
                  1
                ]
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "raw_samples": {
          "const": "samples.jsonl"
        },
        "native_manifests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nemotron": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
