if(CASE STREQUAL matrix)
    set(args --matrix "${REGISTRY}")
else()
    set(args "${CASE}" --dump)
endif()
execute_process(COMMAND "${EXECUTABLE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE observed ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${CASE}: resolver fixture failed: ${result}\n${errors}")
endif()
string(REPLACE "\r\n" "\n" observed "${observed}")
string(SHA256 actual "${observed}")
file(STRINGS "${GOLDEN}" found REGEX "^${CASE} ")
if(NOT found STREQUAL "${CASE} ${actual}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/profile-${CASE}.actual.tsv" "${observed}")
    message(FATAL_ERROR "${CASE} resolution table changed (expected ${found}, got ${actual}).")
endif()
