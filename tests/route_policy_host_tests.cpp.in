namespace route = strix::minimax::route;
namespace fast_i4 = strix::minimax::engine::fast_i4;
struct MiniMaxPolicies {
    strix::xport::ExchangeFormat pf_fmt = strix::xport::ExchangeFormat::f32;
    static constexpr unsigned kFirstMoe = 3, kLayers = 62;
    struct { unsigned rank = 0; } opt;
    bool model_fast_i4 = true, fp32_prefill = false, moe_opt = true;
    fast_i4::Scope i4_scope = fast_i4::scope(nullptr);
    std::size_t i4_min_rows = fast_i4::min_rows(nullptr);
    unsigned i4_a8 = 3, pf_msa_rework = 10, pf_msa_flash = 0;
    strix::core::LayerSet i4_exl3_layers = strix::core::parse_layer_set(fast_i4::kQualityExl3Layers, kFirstMoe, kLayers, "kept");
    strix::core::LayerSet i4_a8_layers = strix::core::parse_layer_set("!", kFirstMoe, kLayers, "a8");
    strix::core::LayerSet pf_msa_flash_layers = strix::core::parse_layer_set("50-61", 0, kLayers, "flash");
    bool attn_prefill_fused = true, index_attn = true, index_tiled = true, index_decode = true;
    std::string pf_msa_flash_asked = "default";
    bool pf_idx_wmma = false;
    std::string pf_idx_wmma_asked = "default";
    strix::core::LayerSet pf_idx_wmma_layers = strix::core::parse_layer_set("40-59", 0, kLayers, "idx");
@MINIMAX_LEVERS@
    std::uint64_t fingerprint() const { rr::reset(); route_levers(); return rr::fingerprint(); }
};
namespace strix::decode_cli {
struct Options {
    DecodeNumericalProfile numerical_profile = DecodeNumericalProfile::exact_v5;
    std::optional<DecodeNumericalProfile> prefill_numerical_profile;
    std::optional<unsigned> prefill_fast_components;
    bool prefill_moe_route_bf16 = false;
    std::optional<std::uint32_t> resolved_qsa_prefill_budget;
    bool automatic_prefill = true, http_serve = false;
    unsigned known_prefix_prefill_rows = 8192;
};
@QWEN_PAIR@
}
struct QwenPolicies {
    unsigned prefill_option_mask = strix::kPrefillOptionsReady;
    bool gsq_owner = false;
    std::string reason = "selected", serve_prefill_notice, arithmetic_fallback, tile_fallback;
};
std::uint64_t qwen_fingerprint(const strix::decode_cli::Options& options, const QwenPolicies& effective) {
    rr::reset();
@QWEN_LEVERS@
    return rr::fingerprint();
}

void minimax() {
    env("STRIX_MMX_MODEL_FORMAT", "fast_i4");
    env("STRIX_MMX_PF_IU4", nullptr);
    mmoe::set_prefill_moe_order(0);  // fixture's adaptive reference, independent of the launching environment
    MiniMaxPolicies p;
    const auto on = p.fingerprint();
    env("STRIX_MMX_PF_IU4", "0");
    different(on, p.fingerprint());
    bool exact_format = false;
    for (const auto& lever : rr::levers())
        if (lever.name == "minimax.moe_prefill_format") exact_format = lever.effective == "exl3";
    require(exact_format, "disabled IU4 must report exact format");
    env("STRIX_MMX_PF_IU4", "1");
    rr::require_same_route(on, p.fingerprint());
    mmoe::g_iu4_override = 0;
    different(on, p.fingerprint());
    mmoe::g_iu4_override = -1;
    p.i4_a8_layers = strix::core::parse_layer_set("39-61", 3, 62, "a8");
    different(on, p.fingerprint());
    const auto a8 = p.fingerprint();
    p.i4_a8_layers = strix::core::parse_layer_set("!3-38", 3, 62, "a8");
    rr::require_same_route(a8, p.fingerprint());
    // These dependencies are extracted or included from the real host policies.
    // Check them so fixture stand-ins cannot silently mask a changed receipt.
    mmoe::set_prefill_moe_order(1);
    different(a8, p.fingerprint());
    mmoe::set_prefill_moe_order(0);
    rr::require_same_route(a8, p.fingerprint());
    p.pf_idx_wmma = true;
    const auto index_on = p.fingerprint();
    different(a8, index_on);
    p.index_attn = p.index_tiled = false;
    rr::require_same_route(a8, p.fingerprint());
    p.index_attn = p.index_tiled = true;
    p.pf_idx_wmma = false;
    p.pf_msa_flash = 1;
    const auto flash1 = p.fingerprint();
    p.attn_prefill_fused = false;
    rr::require_same_route(a8, p.fingerprint());
    p.attn_prefill_fused = true;
    different(a8, flash1);
    p.pf_msa_flash = 2;
    different(flash1, p.fingerprint());
    p.pf_msa_flash = 1;
    p.pf_msa_flash_layers = strix::core::parse_layer_set("51-61", 0, 62, "flash");
    different(flash1, p.fingerprint());
}
std::uint64_t glm_fingerprint(unsigned rank = 0) {
    rr::reset();
    return strix::glm::record_route_levers("cli", rank, "auto", "exact", "r1", 4096);
}
void glm_equivalent() {
    env("STRIX_GLM_PF_WMMA", "1");
    env("STRIX_GLM_PF_EXACT_X", "auto");
    env("STRIX_GLM_PF_KDA_WMMA", nullptr);
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
    const auto defaults = glm_fingerprint();
    env("STRIX_GLM_PF_KDA_WMMA", "1");
    rr::require_same_route(defaults, glm_fingerprint(1));
    {  // FAST indexer projections: the value equal to the default resolves to the same route, the other one differs
        constexpr bool with_fast = strix::glm::pf::idxproj_wmma::kWithFast;
        env("STRIX_GLM_PF_IDXPROJ_WMMA", with_fast ? "1" : "0");
        rr::require_same_route(defaults, glm_fingerprint(1));
        env("STRIX_GLM_PF_IDXPROJ_WMMA", with_fast ? "0" : "1");
        different(defaults, glm_fingerprint());
        env("STRIX_GLM_PF_IDXPROJ_WMMA", nullptr);
    }
    {  // FAST fused attention core and its o-bar image: the server pairs on this fingerprint alone, so both must enter it
        const auto rearm = [] { strix::env_arms::generation_ref().fetch_add(1); };  // switches resolved once per arm
        env("STRIX_GLM_PF_ATTN_WMMA", "1");
        env("STRIX_GLM_PF_ATTN_WMMA_T", "16");
        rr::require_same_route(defaults, glm_fingerprint(1));
        env("STRIX_GLM_PF_ATTN_WMMA_T", "32");
        different(defaults, glm_fingerprint());
        env("STRIX_GLM_PF_ATTN_WMMA_T", nullptr);
        env("STRIX_GLM_PF_ATTN_WMMA", "0");
        different(defaults, glm_fingerprint());
        env("STRIX_GLM_PF_ATTN_WMMA", nullptr);
        env("STRIX_GLM_PF_MLA_OB16", "0");
        rearm();
        rr::require_same_route(defaults, glm_fingerprint(1));
        env("STRIX_GLM_PF_MLA_OB16", "1");
        rearm();
        different(defaults, glm_fingerprint());
        env("STRIX_GLM_PF_ATTN_WMMA", "0");  // without the fused core there is no o-bar image to store
        const auto no_core = glm_fingerprint();
        env("STRIX_GLM_PF_MLA_OB16", nullptr);
        rearm();
        rr::require_same_route(no_core, glm_fingerprint(1));
        env("STRIX_GLM_PF_ATTN_WMMA", nullptr);
        rr::require_same_route(defaults, glm_fingerprint(1));
    }
    // FAST WMMA selected: the auto floor is 32 rows; the exact route's is 64 (glm_pf_dense_policy.hpp).
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "32");
    rr::require_same_route(defaults, glm_fingerprint(1));
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "032");
    rr::require_same_route(defaults, glm_fingerprint(1));
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "2048");
    different(defaults, glm_fingerprint());
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
    env("STRIX_GLM_PF_WMMA", nullptr);
    const auto exact_defaults = glm_fingerprint();
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "64");
    rr::require_same_route(exact_defaults, glm_fingerprint(1));
    env("STRIX_GLM_PF_WMMA", "1");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "32");
    env("STRIX_GLM_PF_KDA_WMMA", "0");
    different(defaults, glm_fingerprint());
    env("STRIX_GLM_PF_EXACT_X", nullptr);
    const auto tm = glm_fingerprint();
    env("STRIX_GLM_PF_EXACT_X", "0");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "0");
    rr::require_same_route(tm, glm_fingerprint(1));
    env("STRIX_GLM_PF_EXACT_X", "auto");
    rejects([] { (void)glm_fingerprint(); }, "auto must still reject an invalid floor");
}
void qwen() {
    strix::decode_cli::Options options;
    QwenPolicies p;
    p.prefill_option_mask = 0;
    const auto exact = qwen_fingerprint(options, p);
    // Every registered option, including explicit candidates, must enter the brief receipt fingerprint.
    for (unsigned i = 0; i < strix::kPrefillOptions.size(); ++i) {
        p.prefill_option_mask = 1U << i;
        different(exact, qwen_fingerprint(options, p));
    }
    p.prefill_option_mask = 0;
    options.resolved_qsa_prefill_budget = 256;
    different(exact, qwen_fingerprint(options, p));
    options.resolved_qsa_prefill_budget.reset();
    options.numerical_profile = strix::DecodeNumericalProfile::hc_splitk_f32_v1;
    different(exact, qwen_fingerprint(options, p));
    options.numerical_profile = strix::DecodeNumericalProfile::exact_v5;
    p.gsq_owner = true;
    different(exact, qwen_fingerprint(options, p));
    p.gsq_owner = false;
    options.prefill_numerical_profile = strix::DecodeNumericalProfile::fast_prefill_f16wmma_v1;
    const auto fast = qwen_fingerprint(options, p);
    different(exact, fast);
    options.prefill_fast_components = strix::kFastPrefillAll & ~strix::kFastPrefillHc;
    different(fast, qwen_fingerprint(options, p));
}
// One resolver for the serving prefill chunk: the server (entry http) and the rank CLI resolve the same value, the same
// dense route for the chunk's calls and the same route fingerprint from the same environment and arguments.
void glm_serve_chunk() {
    namespace dp = strix::glm::pf::dense_policy;
    namespace exact = strix::glm::pf::exact;
    const auto same = [](const dp::Chunk& a, const dp::Chunk& b) {
        return a.tokens == b.tokens && a.rows == b.rows && a.max_call_rows == b.max_call_rows && a.mixed == b.mixed &&
               a.applicable == b.applicable && a.route == b.route && a.wmma == b.wmma && a.declined == b.declined &&
               a.reason == b.reason;
    };
    for (const char* fast : {static_cast<const char*>(nullptr), "1"}) {
        env("STRIX_GLM_PF_WMMA", fast);
        env("STRIX_GLM_PF_EXACT_X", "auto");
        env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
        env("STRIX_GLM_PF_SEQPAR", nullptr);
        env("STRIX_GLM_PF_PIPELINE", "2");
        rr::reset();
        const auto cli_fp = strix::glm::record_route_levers("cli", 0, "auto", "gemv", "r1b", 4096);
        const auto cli = strix::glm::record_prefill_chunk("cli", false, 0, 2, 4096, "gemv");
        rr::reset();
        const auto http_fp = strix::glm::record_route_levers("http", 0, "auto", "gemv", "r1b", 4096);
        const auto http = strix::glm::record_prefill_chunk("http", false, 0, 2, 4096, "gemv");
        rr::require_same_route(cli_fp, http_fp);
        require(same(cli, http), "server and CLI resolve the same serving chunk");
        {   // --print-effective-config of the server (dry run): the app-set values are pending, not applied, yet the
            // printed interleave is the live one (same route identity per call size, same description).
            const auto live = serve_prefill_interleave("gemv", 4096, 2);
            env("STRIX_GLM_PF_EXACT_X", nullptr);
            env("STRIX_GLM_PF_PIPELINE", nullptr);
            const strix::glm::PendingEnv pending([](const auto& set) {
                set("STRIX_GLM_PF_EXACT_X", "auto");
                set("STRIX_GLM_PF_PIPELINE", "2");
            });
            const unsigned pipeline = strix::glm::xfer::prefill_pipeline(1, pending("STRIX_GLM_PF_PIPELINE"));
            require(pipeline == 2, "dry run sees the app-set pipeline");
            const auto dry = serve_prefill_interleave("gemv", 4096, pipeline, pending);
            require(std::getenv("STRIX_GLM_PF_EXACT_X") == nullptr, "dry run applies nothing");
            const auto unapplied = serve_prefill_interleave("gemv", 4096, 2, [](const char* n) { return static_cast<const char*>(std::getenv(n)); });
            require(live.route_identity && dry.route_identity, "gemv interleave keeps routes");
            require(dry.describe(512) == live.describe(512), "dry-run interleave description equals the live one");
            for (std::size_t tokens : {1U, 31U, 32U, 63U, 64U, 100U, 129U, 512U, 1024U, 2048U, 4096U, 4097U, 4200U, 8192U, 12000U})
                require(dry.route_identity(tokens) == live.route_identity(tokens), "dry-run route identity equals the live one");
            require(unapplied.route_identity(4096) != live.route_identity(4096),
                    "discriminating: the unapplied environment would resolve another route");
            require(serve_prefill_interleave("ref", 4096, 2, pending).route_identity == nullptr, "reference prefill: no route identity");
            env("STRIX_GLM_PF_EXACT_X", "0");  // an explicit value wins over the pending default (set if unset)
            const strix::glm::PendingEnv explicit_off([](const auto& set) { set("STRIX_GLM_PF_EXACT_X", "auto"); });
            require(serve_prefill_interleave("gemv", 4096, 2, explicit_off).route_identity(4096) == std::optional<unsigned>(dp::kTm),
                    "explicit STRIX_GLM_PF_EXACT_X wins in the dry run");
            env("STRIX_GLM_PF_EXACT_X", "auto");
            env("STRIX_GLM_PF_PIPELINE", "2");
        }
        {   // The decode-cohort grouping of that chunk (serving only: named in the effective config). Without a decode
            // cohort (the CLI, an idle server) the prompt is one call; a grouped chunk keeps the base chunk's route.
            namespace sv = strix::serve;
            const auto il = serve_prefill_interleave("gemv", 4096, 2);
            require(il.select == sv::PrefillInterleave::Select::automatic && il.max_scale == 4, "interleave defaults");
            const auto whole = il.plan(http.tokens, 8192, 0, 4096, 1.0);
            require(whole.tokens == 8192 && whole.decode_rounds == 0, "no decode cohort: whole prompt, as in the CLI");
            const auto first = il.plan(http.tokens, 8192, 1, 4096, 0.0);
            require(first.tokens == http.tokens && first.decode_rounds == 1, "first chunk of a prompt stays at the resolved chunk");
            const auto grown = il.plan(http.tokens, 8192 - 512, 1, 4096, 1.0);
            require(grown.tokens == 4U * http.tokens && grown.decode_rounds == 4, "small cohort: 4 chunks grouped, 4 decode rounds kept");
            require(il.plan(http.tokens, 8192, 3, 4096, 1.0).tokens == 2U * http.tokens, "cohort of 3-4: 2 chunks grouped");
            require(il.plan(http.tokens, 8192, 5, 4096, 1.0).tokens == http.tokens, "cohort above 4: the base chunk");
            require(il.plan(http.tokens, 8192, 1, 4096, 2.0).tokens == 2U * http.tokens, "decode stall bound halves the group");
            require(il.plan(http.tokens, 8192, 1, 1024, 1.0).tokens == 1024, "engine call bound");
            require(il.plan(http.tokens, 700, 1, 4096, 1.0).tokens == 700 && il.plan(http.tokens, 700, 1, 4096, 1.0).decode_rounds == 2,
                    "prompt tail");
            const auto grouped = strix::glm::record_prefill_chunk("http", true, static_cast<unsigned>(grown.tokens), 2, 4096, "gemv");
            require(grouped.route == http.route && grouped.wmma == http.wmma && !grouped.declined, "grouped chunk keeps the resolved route");
            require(il.describe(http.tokens).find("preserves base and tail arithmetic routes") != std::string::npos,
                    "effective config describes the route guard");
            // Short explicit bases must not grow across the auto threshold (FAST: 32 rows per half).
            // Check the entire 80-token prompt, not just a full default chunk.
            std::size_t remaining = 80;
            double cost = 0;
            unsigned calls = 0;
            while (remaining != 0) {
                const auto p = il.plan(16, remaining, 1, 4096, cost);
                const auto c = strix::glm::record_prefill_chunk("http", true, static_cast<unsigned>(p.tokens), 2, 4096, "gemv");
                require(c.route == dp::kTm && !c.wmma && !c.mixed, "small-base grouping preserves TM arithmetic");
                remaining -= p.tokens;
                cost = 1.0;
                ++calls;
            }
            require(calls == (fast ? 3U : 2U), "only threshold-crossing 16+64 grouping was declined");
            // Grouping a short tail into a large call must not upgrade that tail's arithmetic.
            require(il.plan(512, 530, 1, 4096, 1.0).tokens == 512, "short TM tail remains a separate call");
            require(il.plan(512, 640, 1, 4096, 1.0).tokens == 640, "same-route tail may still group");
            const auto mixed = serve_prefill_interleave("gemv", 500, 2);
            require(mixed.plan(512, 1024, 1, 4096, 1.0).tokens == 512, "mixed base declines grouping");
            // Engine splitting is still required for base/whole-prompt calls exceeding the grouping cap.
            require(il.plan(512, 8192, 1, 128, 1.0).tokens == 512, "cap does not truncate base");
            require(il.plan(0, 8192, 1, 128, 1.0).tokens == 8192, "cap does not truncate unchunked calls");
            require(il.describe(http.tokens).find("serving only") != std::string::npos, "effective config names the serving-only lever");
            env("STRIX_SERVE_PREFILL_INTERLEAVE", "0");
            require(sv::PrefillInterleave::from_env(strix::envcfg::text).plan(http.tokens, 8192, 1, 4096, 1.0).tokens == http.tokens,
                    "off switch: one base chunk per decode round");
            env("STRIX_SERVE_PREFILL_INTERLEAVE", nullptr);
        }
        {
            strix::serve::PrefillDecodeDebt debt;
            const auto il = serve_prefill_interleave("gemv", 4096, 2);
            debt.charge(il.plan(512, 2048, 1, 4096, 1.0));
            for (unsigned round = 0; round < 4; ++round) {
                require(!debt.ready(), "final grouped chunk retains all four rounds for a queued successor");
                debt.decoded();
            }
            require(debt.ready(), "successor prefill admitted after four decode rounds");
            debt.charge(il.plan(512, 2048, 1, 4096, 1.0));
            debt.clear();
            require(debt.ready(), "no decoder: stale debt cleared");
        }
        // Default chunk: 512 tokens are two 256-row calls on the pair, and they keep the large-call core.
        require(http.tokens == 512 && http.rows == 256 && !http.declined && http.route == dp::kX3r8, "default chunk keeps the X3 route");
        require(http.wmma == (fast != nullptr), "default chunk keeps the FAST WMMA core when it is selected");
        require(static_cast<unsigned>(exact::route(http.rows)) == http.route, "the launcher selects the resolved route");
        // What the launcher does with one such call is what the resolver said.
        rr::reset();
        rr::set_enabled(true);
        exact::dispatch_receipt(http.rows);
        const auto t = rr::snapshot();
        const auto dense = static_cast<unsigned>(rr::Product::dense);
        require(t.product[dense][static_cast<unsigned>(fast ? rr::Family::f16_wmma : rr::Family::exact)].launches == 1,
                "chunk call family");
        // Pipeline 2 also halves calls on one node.
        require(strix::glm::record_prefill_chunk("http", false, 0, 1, 4096, "gemv").rows == 256, "one node pipeline also halves chunk rows");
        // The former threshold: the default chunk cannot reach it below the stall ceiling, so the decline is said.
        env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "2048");
        const auto old = strix::glm::record_prefill_chunk("http", false, 0, 2, 4096, "gemv");
        require(old.tokens == 512 && old.declined && old.route == dp::kTm && old.reason.find("short_call") != std::string::npos,
                "declined route carries its reason");
        require(dp::chunk_line(old).find("declined (short_call)") != std::string::npos, "reason line");
        // A threshold the default can reach by growing: 512 -> 1024 tokens (two 512-row calls).
        env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "512");
        const auto grown = strix::glm::record_prefill_chunk("http", false, 0, 2, 4096, "gemv");
        require(grown.tokens == 1024 && grown.rows == 512 && !grown.declined, "default chunk grows to keep the route");
        // An explicit chunk is never changed; a short one says what it loses.
        const auto small = strix::glm::record_prefill_chunk("http", true, 256, 2, 4096, "gemv");
        require(small.tokens == 256 && small.rows == 128 && small.declined, "explicit chunk is kept and reported");
        env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
        const auto off = strix::glm::record_prefill_chunk("http", true, 0, 2, 4096, "gemv");
        require(off.tokens == 0 && off.rows == 0 && !off.wmma && off.reason.find("prompt length") != std::string::npos, "chunking off");
        env("STRIX_GLM_PF_EXACT_X", "0");
        const auto forced = strix::glm::record_prefill_chunk("http", false, 0, 2, 4096, "gemv");
        require(forced.route == dp::kTm && forced.declined == (fast != nullptr), "forced TM16 declines only the FAST core");
        env("STRIX_GLM_PF_EXACT_X", "auto");
    }
    env("STRIX_GLM_PF_PIPELINE", nullptr);
    env("STRIX_GLM_PF_WMMA", "1");
}
// Independent schedule oracle: partition expressions are extracted from engine execution, SP tiles are its
// existing host helper, and every nonempty call is checked against the actual launcher selector.
std::vector<unsigned> engine_calls(unsigned tokens, unsigned max_rows, unsigned world, bool seqpar, unsigned pipeline) {
    namespace xfer = strix::glm::xfer;
    const struct { unsigned max_rows, pf_pipeline; } opt{max_rows, pipeline};
    const std::size_t C = @GLM_ENGINE_CAPACITY@;
    std::vector<unsigned> calls;
    for (std::size_t first = 0; first < tokens; first += C) {
        const unsigned R = static_cast<unsigned>(std::min(C, tokens - first));
        if (world == 2 && seqpar && xfer::seqpar_admits(R)) {
            const unsigned block = @GLM_SEQPAR_BLOCK@;
            for (unsigned i = 0; i < xfer::seqpar_tiles(R, pipeline); ++i) {
                const auto tile = xfer::seqpar_tile(R, pipeline, i);
                for (unsigned r = 0; r < tile.count; r += block) calls.push_back(std::min(block, tile.count - r));
            }
        } else if (pipeline == 2) {
            const unsigned A = @GLM_PIPELINE_HALF@;
            calls.push_back(A);
            if (R != A) calls.push_back(R - A);
        } else calls.push_back(R);
    }
    return calls;
}
void glm_schedule() {
    namespace dp = strix::glm::pf::dense_policy;
    namespace exact = strix::glm::pf::exact;
    env("STRIX_GLM_PF_EXACT_X", "auto");
    env("STRIX_GLM_PF_WMMA", "1");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
    for (unsigned pipeline : {1U, 2U}) for (unsigned world : {1U, 2U}) for (bool seqpar : {false, true}) {
        env("STRIX_GLM_PF_PIPELINE", pipeline == 2 ? "2" : "1");
        env("STRIX_GLM_PF_SEQPAR", seqpar ? "1" : "0");
        for (unsigned cap : {0U, 1U, 62U, 63U, 256U, 500U, 513U, 4096U})
            for (unsigned tokens : {1U, 2U, 62U, 63U, 64U, 512U, 513U, 1024U}) {
                const auto calls = engine_calls(tokens, cap, world, seqpar, pipeline);
                const auto c = strix::glm::record_prefill_chunk("http", true, tokens, world, cap, "gemv");
                bool all_x3 = true, mixed = false;
                for (unsigned rows : calls) {
                    const auto route = static_cast<unsigned>(exact::route(rows));
                    all_x3 = all_x3 && route == dp::kX3r8;
                    mixed = mixed || route != c.route;
                }
                require(c.tokens == tokens && c.rows == *std::min_element(calls.begin(), calls.end()) &&
                        c.max_call_rows == *std::max_element(calls.begin(), calls.end()), "all engine subchunks/halves counted");
                require(c.wmma == all_x3 && c.declined == !all_x3 && c.mixed == mixed, "schedule determines route/decline");
            }
    }
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "512");
    env("STRIX_GLM_PF_PIPELINE", "2");
    for (unsigned world : {1U, 2U}) for (const char* sp : {"0", "1"}) {
        env("STRIX_GLM_PF_SEQPAR", sp);
        const auto c = strix::glm::record_prefill_chunk("http", false, 0, world, 4096, "gemv");
        require(c.tokens == 1024 && c.rows == 512 && !c.declined, "growth applies to TP1 and seqpar off too");
    }
    // A small engine remainder defeats apparent full-subchunk eligibility, even at the growth ceiling.
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "64");
    const auto tail = strix::glm::record_prefill_chunk("http", false, 0, 2, 500, "gemv");
    require(tail.tokens == 512 && tail.rows == 6 && tail.declined && tail.mixed, "growth must include engine remainder");
}
// Request-fixed dense core (glm_pf_dense_policy.hpp pin_*): the core of every prompt row is the CLI's for that prompt
// whatever chunks the traffic proposes. Oracle: the engine's own call partition (engine_calls) and the launcher's
// route choice per call, rows of the whole prompt in one call sequence (the CLI) against rows of the chunks.
std::vector<unsigned> row_cores(const std::vector<std::size_t>& chunks, unsigned cap, unsigned pipeline = 1) {
    namespace dp = strix::glm::pf::dense_policy;
    std::vector<unsigned> cores;
    for (const auto tokens : chunks)
        for (const unsigned rows : engine_calls(static_cast<unsigned>(tokens), cap, 1, false, pipeline)) {
            const auto route = dp::choose(rows, strix::envcfg::text).route;
            cores.insert(cores.end(), rows, route);
        }
    return cores;
}
void glm_pin() {
    namespace dp = strix::glm::pf::dense_policy;
    env("STRIX_GLM_PF_EXACT_X", "auto");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", nullptr);
    env("STRIX_GLM_PF_PIPELINE", "1");
    env("STRIX_GLM_PF_WMMA", "1");
    std::size_t unpinned_mismatch = 0, pinned_chunks = 0;
    for (const unsigned cap : {64U, 100U, 512U, 2048U}) {
        const auto shape = dp::pin_shape(0, cap, 1, strix::envcfg::text);
        require(shape.active && shape.min_rows == dp::kWmmaMinRows, "pin active under FAST WMMA with the auto core");
        std::vector<std::size_t> prompts;
        for (std::size_t p = 1; p <= 140; ++p) prompts.push_back(p);
        for (const std::size_t k : {1U, 2U, 3U})
            for (int d = -40; d <= 40; ++d) prompts.push_back(k * cap + d > 0 ? k * cap + d : 1);
        for (const auto prompt : prompts) {
            const auto cli = row_cores({prompt}, cap);
            require(cli.size() == prompt, "oracle covers every row");
            // Several traffic patterns: the proposed chunk size per step (a cohort of any width, a lone prompt that
            // takes the whole rest, the 512-token base chunk, grouped chunks) and every start phase.
            for (const std::size_t base : {std::size_t{1}, std::size_t{7}, std::size_t{31}, std::size_t{32}, std::size_t{33},
                                           std::size_t{63}, std::size_t{64}, std::size_t{512}, std::size_t{513},
                                           std::size_t{1024}, std::size_t{100000}}) {
                for (const bool pin : {false, true}) {
                    auto s = shape;
                    s.prompt = prompt;
                    std::vector<std::size_t> chunks;
                    std::size_t done = 0, step = 0;
                    while (done < prompt) {
                        std::size_t m = std::min(prompt - done, base + (step % 3) * (base / 2));  // traffic varies per step
                        if (pin) m = dp::pin_chunk(s, done, m);
                        require(m >= 1 && done + m <= prompt, "chunk inside the prompt");
                        if (pin) require(dp::pin_admits(s, done, done + m), "pinned chunk is an admitted end");
                        chunks.push_back(m);
                        done += m;
                        ++step;
                    }
                    const bool same = row_cores(chunks, cap) == cli;
                    if (pin) {
                        require(same, "pinned chunks keep the CLI core of every row");
                        pinned_chunks += chunks.size();
                    } else if (!same) ++unpinned_mismatch;
                }
            }
        }
    }
    require(unpinned_mismatch > 0, "without the pin the chunks move rows to another core (the test is sensitive)");
    require(pinned_chunks > 0, "pinned runs executed");
    // Single shot: the whole prompt in one chunk whenever that is the CLI partition; 512-row base on a 2048-row call.
    {
        auto s = dp::pin_shape(2054, 2048, 1, strix::envcfg::text);
        require(dp::pin_chunk(s, 0, 2054) == 2054, "whole prompt with the CLI tail (call 2048 + 6) is admitted as is");
        require(dp::pin_chunk(s, 0, 1030) == 1030, "a chunk of the WMMA class that leaves the CLI call whole is unchanged");
        require(dp::pin_chunk(s, 0, 2050) == 2054, "a chunk ending inside the 6-row CLI tail extends to the prompt end");
        require(dp::pin_chunk(s, 2048, 512) == 6, "the 6-row CLI tail runs as its own TM call");
        require(dp::pin_chunk(s, 0, 512) == 512 && dp::pin_chunk(s, 512, 512) == 512, "a base chunk of whole WMMA calls is unchanged");
        require(dp::pin_chunk(s, 1536, 512) == 512, "a chunk ending on the CLI call boundary is unchanged");
        require(dp::pin_chunk(s, 1520, 512) == 528, "a chunk that would leave a gap under the floor is extended to the call end");
    }
    // Root snapshot cuts: reusable only when the rows before it hold the head class under any prompt length.
    {
        auto s = dp::pin_shape(2054, 2048, 1, strix::envcfg::text);
        require(dp::pin_root_admits(s, 0, 512), "root inside the head calls");
        require(!dp::pin_root_admits(s, 0, 2054), "root at a TM tail end is not reusable by a longer prompt");
        s = dp::pin_shape(2100, 2048, 1, strix::envcfg::text);
        require(dp::pin_root_admits(s, 0, 2100), "a WMMA tail has the head class: reusable");
    }
    // Pipeline 2 (each call split into two column halves): the same oracle, every row's core equals the CLI's.
    env("STRIX_GLM_PF_PIPELINE", "2");
    for (const unsigned cap : {64U, 256U, 512U}) {
        for (std::size_t prompt = 1; prompt <= 1100; prompt += (prompt < 140 ? 1 : 7)) {
            auto s = dp::pin_shape(prompt, cap, 2, strix::envcfg::text);
            const auto cli = row_cores({prompt}, cap, 2);
            for (const std::size_t base : {std::size_t{33}, std::size_t{63}, std::size_t{100}, std::size_t{512}}) {
                std::vector<std::size_t> chunks;
                std::size_t done = 0, step = 0;
                while (done < prompt) {
                    const auto m = dp::pin_chunk(s, done, std::min(prompt - done, base + (step++ % 2) * 29));
                    require(m >= 1 && done + m <= prompt, "pipeline 2: chunk inside the prompt");
                    require(dp::pin_admits(s, done, done + m) || done + m == prompt, "pipeline 2: admitted end");
                    chunks.push_back(m);
                    done += m;
                }
                require(row_cores(chunks, cap, 2) == cli, "pipeline 2: pinned chunks keep the CLI core of every row");
            }
        }
    }
    // EXACT (no WMMA identity) and forced routes: no pin (X3 == TM bits, a forced route is one core).
    env("STRIX_GLM_PF_PIPELINE", "1");
    env("STRIX_GLM_PF_WMMA", nullptr);
    require(!dp::pin_shape(2054, 2048, 1, strix::envcfg::text).active, "EXACT: no pin");
    env("STRIX_GLM_PF_WMMA", "1");
    env("STRIX_GLM_PF_EXACT_X", "4");
    require(!dp::pin_shape(2054, 2048, 1, strix::envcfg::text).active, "forced route: no pin");
    require(dp::pin_chunk(dp::pin_shape(2054, 2048, 1, strix::envcfg::text), 0, 1030) == 1030, "inactive pin keeps the proposal");
    env("STRIX_GLM_PF_EXACT_X", "auto");
}
void glm_reference() {
    namespace dp = strix::glm::pf::dense_policy;
    env("STRIX_GLM_PF_PIPELINE", "2");
    env("STRIX_GLM_PF_EXACT_X", "auto");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "512");
    env("STRIX_GLM_PF_WMMA", "1");
    for (const char* mode : {"ref", "wmma"}) for (bool explicit_request : {false, true}) for (unsigned requested : {0U, 62U}) {
        const auto check = [&](const dp::Chunk& c) {
            require(c.tokens == (explicit_request ? requested : 512) && !c.applicable && !c.wmma && c.rows == 0,
                    "inapplicable prefill retains chunk without a dense route");
            require(dp::chunk_line(c).find("inapplicable") != std::string::npos, "inapplicable config line");
        };
        rr::reset();
        check(strix::glm::record_prefill_chunk("http", explicit_request, requested, 2, 4096, mode));
        check(strix::glm::pending_prefill_chunk(explicit_request, requested, 2, 4096, mode,
            [](auto set) { set("STRIX_GLM_PF_SEQPAR", "1"); }));
    }
    // Neither dry-run nor execution should parse selectors that this implementation cannot execute.
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "invalid");
    require(!strix::glm::record_prefill_chunk("http", false, 0, 2, 4096, "ref").applicable, "reference ignores dense floor");
    require(!strix::glm::pending_prefill_chunk(false, 0, 2, 4096, "ref", [](auto) {}).applicable, "dry reference ignores dense floor");
}
void glm_dense_baseline() {
    for (const char* inherited : {static_cast<const char*>(nullptr), "16", "32", "64"}) {
        env("STRIX_GLM_PF_EXACT_TM", inherited);
        for (bool unwind : {false, true}) {
            try {
@GLM_BENCH_SETUP@
                require(strix::glm::pf::exact::tile_rows() == 16, "dense-rows pins TM16 regardless of inherited tile");
                if (unwind) throw 1;
            } catch (int) {}
            const char* restored = strix::envcfg::text("STRIX_GLM_PF_EXACT_TM");
            require(inherited ? restored && std::strcmp(restored, inherited) == 0 : restored == nullptr,
                    "dense-rows restores inherited tile on normal and exceptional exit");
        }
    }
}
void glm_bypass() {
    namespace exact = strix::glm::pf::exact;
    env("STRIX_GLM_PF_WMMA", "1");
    // Forced TM and all forced X variants never parse the irrelevant auto floor.
    for (const char* mode : {"0", "1", "2", "3", "4"}) {
        env("STRIX_GLM_PF_EXACT_X", mode);
        for (const char* floor : {"0", "", "invalid"}) {
            env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", floor);
            rr::reset();
            rr::set_enabled(false);
            exact::dispatch_receipt(512);
            require(rr::snapshot().empty(), "disabled receipt counters");
            rr::set_enabled(true);
            exact::dispatch_receipt(512);
            if (std::strcmp(mode, "4") != 0) {
                const auto t = rr::snapshot();
                require(t.bypass[static_cast<unsigned>(rr::Product::dense)][static_cast<unsigned>(rr::Reason::wrong_route)].launches == 1,
                        "forced exact route must report wrong_route");
            }
        }
    }
    env("STRIX_GLM_PF_EXACT_X", "auto");
    env("STRIX_GLM_PF_EXACT_X_MIN_ROWS", "2048");
    rr::reset();
    rr::set_enabled(true);
    exact::dispatch_receipt(2047);
    exact::dispatch_receipt(2048);
    exact::dispatch_receipt(2048, 96);
    const auto t = rr::snapshot();
    const auto dense = static_cast<unsigned>(rr::Product::dense);
    require(t.bypass[dense][static_cast<unsigned>(rr::Reason::short_call)].launches == 1, "auto short call");
    require(t.bypass[dense][static_cast<unsigned>(rr::Reason::shape)].launches == 1, "auto wrong shape");
    require(t.product[dense][static_cast<unsigned>(rr::Family::f16_wmma)].launches == 1, "auto at threshold");
}
int main(int argc, char** argv) {
#if defined(_MSC_VER)
    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
    _CrtSetReportMode(_CRT_ASSERT, _CRTDBG_MODE_FILE);
    _CrtSetReportFile(_CRT_ASSERT, _CRTDBG_FILE_STDERR);
#endif
    try {
        require(argc == 2, "expected test case");
        const std::string name = argv[1];
        if (name == "minimax") minimax();
        else if (name == "glm_equivalent") glm_equivalent();
        else if (name == "qwen") qwen();
        else if (name == "glm_bypass") glm_bypass();
        else if (name == "glm_serve_chunk") glm_serve_chunk();
        else if (name == "glm_schedule") glm_schedule();
        else if (name == "glm_pin") glm_pin();
        else if (name == "glm_reference") glm_reference();
        else if (name == "glm_dense_baseline") glm_dense_baseline();
        else throw std::runtime_error("unknown test case");
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
    return 0;
}
