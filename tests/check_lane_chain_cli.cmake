foreach(mode IN ITEMS dependency duplicate)
    if(mode STREQUAL "dependency")
        set(flags --lane-chain-hyper-output)
        set(expected "requires --prefetch-q8-hyper-output")
    else()
        set(flags --lane-chain-hyper-output --lane-chain-hyper-output)
        set(expected "duplicate lane-chain HC output option")
    endif()
    execute_process(COMMAND "${APP}" missing-lane-chain-model.gguf 1 ${flags} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "lane-chain CLI ${mode} failed: ${result}: ${error}")
    endif()
endforeach()
