# Device declaration (strix-devices-v1) and the start gate every GPU binary calls before its first allocation.
# Host-only; usable from the full build and from the standalone CUDA configurations.
include(${CMAKE_CURRENT_LIST_DIR}/StrixPower.cmake)
if(TARGET strix_device)
    return()
endif()
if(NOT TARGET strix_model_description)
    add_library(strix_model_description STATIC ${CMAKE_CURRENT_LIST_DIR}/../src/model_description.cpp)
    target_include_directories(strix_model_description PUBLIC ${CMAKE_CURRENT_LIST_DIR}/../include)
    target_compile_features(strix_model_description PUBLIC cxx_std_20)
endif()
add_library(strix_device STATIC
    ${CMAKE_CURRENT_LIST_DIR}/../src/device/declaration.cpp
    ${CMAKE_CURRENT_LIST_DIR}/../src/device/gate.cpp
    ${CMAKE_CURRENT_LIST_DIR}/../src/device/nvidia_smi.cpp)
target_link_libraries(strix_device PUBLIC strix_model_description)
target_compile_features(strix_device PUBLIC cxx_std_20)
if(MSVC)
    target_compile_definitions(strix_device PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
if(COMMAND strix_target_warnings)
    strix_target_warnings(strix_device)
endif()
if(BUILD_TESTING)
    add_executable(strix-device-gate-tests ${CMAKE_CURRENT_LIST_DIR}/../tests/device_gate_tests.cpp)
    target_link_libraries(strix-device-gate-tests PRIVATE strix_device)
    if(COMMAND strix_target_warnings)
        strix_target_warnings(strix-device-gate-tests)
    endif()
    add_test(NAME strix-device-gate-tests COMMAND strix-device-gate-tests)
endif()

# HIP side of the gate. Defined at the end of the configuration, when the HIP toolkit has been located; without the HIP
# runtime the same functions exist and bind nothing, so a main can call them in every configuration.
function(strix_device_add_hip_gate)
    if(TARGET strix_device_hip)
        return()
    endif()
    set(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(STRIX_ENABLE_HIP_RUNTIME AND STRIX_HIP_INCLUDE_DIR AND STRIX_HIP_RUNTIME_LIBRARY)
        add_library(strix_device_hip STATIC ${_root}/src/device/hip_gate.cpp)
        target_include_directories(strix_device_hip SYSTEM PRIVATE "${STRIX_HIP_INCLUDE_DIR}")
        target_compile_definitions(strix_device_hip PRIVATE __HIP_PLATFORM_AMD__=1)
        target_link_libraries(strix_device_hip PUBLIC strix_device PRIVATE "${STRIX_HIP_RUNTIME_LIBRARY}")
        if(BUILD_TESTING)
            add_executable(strix-hip-device-gate-probe ${_root}/tests/hip/device_gate_probe.cpp)
            target_include_directories(strix-hip-device-gate-probe SYSTEM PRIVATE "${STRIX_HIP_INCLUDE_DIR}")
            target_compile_definitions(strix-hip-device-gate-probe PRIVATE __HIP_PLATFORM_AMD__=1)
            target_link_libraries(strix-hip-device-gate-probe PRIVATE strix_device_hip "${STRIX_HIP_RUNTIME_LIBRARY}")
        endif()
    else()
        add_library(strix_device_hip STATIC ${_root}/src/device/hip_gate_none.cpp)
        target_link_libraries(strix_device_hip PUBLIC strix_device)
    endif()
    target_compile_features(strix_device_hip PUBLIC cxx_std_20)
    # The HIP gate starts the shared power sampler at bind (cmake/StrixPower.cmake).
    target_link_libraries(strix_device_hip PUBLIC strix_power)
    if(COMMAND strix_target_warnings)
        strix_target_warnings(strix_device_hip)
    endif()
endfunction()
cmake_language(DEFER CALL strix_device_add_hip_gate)
