include_guard(GLOBAL)
get_filename_component(_strix_cpu_isa_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(strix_cpu_isa STATIC "${_strix_cpu_isa_root}/src/cpu/core/isa.cpp")
target_include_directories(strix_cpu_isa PUBLIC "${_strix_cpu_isa_root}/src")
target_compile_features(strix_cpu_isa PUBLIC cxx_std_20)
if(COMMAND strix_target_warnings)
    strix_target_warnings(strix_cpu_isa)
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64|X86_64|x64")
    if(MSVC)
        target_compile_options(strix_cpu_isa PRIVATE /arch:SSE2)
    else()
        target_compile_options(strix_cpu_isa PRIVATE -march=x86-64)
    endif()
endif()
