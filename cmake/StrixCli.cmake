# Configure after backend targets exist, but before packaging consumes the tools target.
function(strix_add_cli)
    if(STRIX_CUDA_CORE_ONLY)
        return()
    endif()
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    include(GNUInstallDirs)

    # The standalone CUDA service has the device layer but skips these host targets.
    if(NOT TARGET strix_model_registry)
        add_library(strix_model_registry STATIC "${root}/src/model_registry.cpp")
        target_link_libraries(strix_model_registry PUBLIC strix_model_description)
    endif()
    if(NOT TARGET strix_serve_json)
        add_library(strix_serve_json STATIC "${root}/src/serve/json.cpp")
        target_include_directories(strix_serve_json PUBLIC "${root}/include")
        target_compile_features(strix_serve_json PUBLIC cxx_std_20)
    endif()
    if(NOT TARGET strix_deploy)
        add_library(strix_deploy STATIC "${root}/src/deploy/device.cpp" "${root}/src/deploy/spec.cpp"
            "${root}/src/deploy/plan.cpp" "${root}/src/deploy/link.cpp" "${root}/src/deploy/route.cpp")
        target_link_libraries(strix_deploy PUBLIC strix_device)
    endif()
    if(NOT TARGET strix_engine_deploy)
        add_library(strix_engine_deploy STATIC "${root}/src/minimax/engine/deployment.cpp"
            "${root}/src/gemma4/engine/deployment.cpp" "${root}/src/gguf_reader.cpp")
        target_include_directories(strix_engine_deploy PUBLIC "${root}/src")
        target_link_libraries(strix_engine_deploy PUBLIC strix_deploy strix_serve_json)
    endif()

    add_library(strix_cli STATIC "${root}/src/cli/cli.cpp" "${root}/src/cli/doctor.cpp"
        "${root}/src/cli/inspection.cpp" "${root}/src/cli/process.cpp"
        "${root}/src/linux_uma_observation.cpp" "${root}/src/uma_owner_inventory.cpp")
    target_include_directories(strix_cli PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
    target_link_libraries(strix_cli PUBLIC strix_model_registry PRIVATE strix_engine_deploy ${CMAKE_DL_LIBS})
    if(TARGET strix_qwen_model_description)
        target_link_libraries(strix_cli PRIVATE strix_qwen_model_description)
        target_compile_definitions(strix_cli PRIVATE STRIX_CLI_QWEN_DESCRIPTION=1)
    else()
        target_compile_definitions(strix_cli PRIVATE STRIX_CLI_QWEN_DESCRIPTION=0)
    endif()
    if(TARGET strix_device_intel)
        target_link_libraries(strix_cli PRIVATE strix_device_intel)
    else()
        target_sources(strix_cli PRIVATE "${root}/src/device/xpu_smi.cpp")
    endif()
    file(RELATIVE_PATH cli_data "${CMAKE_INSTALL_FULL_BINDIR}" "${CMAKE_INSTALL_FULL_DATADIR}/strix")
    target_compile_definitions(strix_cli PRIVATE "STRIX_CLI_DATA_FROM_BIN=\"${cli_data}\"")
    if(WIN32)
        target_compile_definitions(strix_cli PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
    strix_target_warnings(strix_cli)

    add_executable(strix "${root}/apps/strix_main.cpp")
    target_link_libraries(strix PRIVATE strix_cli)
    strix_target_warnings(strix)
    file(GLOB descriptions CONFIGURE_DEPENDS "${root}/models/*.toml")
    foreach(description IN LISTS descriptions)
        get_filename_component(filename "${description}" NAME)
        configure_file("${description}" "${CMAKE_CURRENT_BINARY_DIR}/share/strix/models/${filename}" COPYONLY)
    endforeach()

    if(BUILD_TESTING)
        add_executable(strix-cli-tests "${root}/tests/cli_tests.cpp")
        target_link_libraries(strix-cli-tests PRIVATE strix_cli strix_serve_json)
        target_compile_definitions(strix-cli-tests PRIVATE "STRIX_CLI_FIXTURE=\"${root}/tests/fixtures/cli\""
            "STRIX_CLI_BUILD_DATA=\"${CMAKE_CURRENT_BINARY_DIR}/share/strix\"")
        strix_target_warnings(strix-cli-tests)
        add_test(NAME strix-cli-tests COMMAND strix-cli-tests)
    endif()
endfunction()
cmake_language(DEFER CALL strix_add_cli)
