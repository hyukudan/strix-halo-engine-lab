if(MODE STREQUAL "spirv")
    file(READ "${INPUT}" shader HEX)
    string(LENGTH "${shader}" digits)
    math(EXPR remainder "${digits} % 8")
    if(digits LESS 40 OR NOT remainder EQUAL 0 OR NOT shader MATCHES "^03022307")
        message(FATAL_ERROR "Invalid SPIR-V header or word length: ${INPUT}")
    endif()
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u,\n" words "${shader}")
    file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\n\nnamespace strix::vulkan {\n"
        "inline constexpr std::uint32_t rms_norm_spirv[] = {\n${words}};\n}\n")
else()
    file(READ "${INPUT}" shader)
    if(MODE STREQUAL "glsl")
        set(backend vulkan)
        set(entry "#version 450" "void main()" "layout(push_constant)" "binding = 0" "binding = 1" "binding = 2")
    elseif(MODE STREQUAL "msl")
        set(backend metal)
        set(entry "kernel void rms_norm" "buffer(0)" "buffer(1)" "buffer(2)" "buffer(3)")
    else()
        message(FATAL_ERROR "Unknown GPU shader embedding mode: ${MODE}")
    endif()
    foreach(token IN LISTS entry)
        string(FIND "${shader}" "${token}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Missing RMSNorm entrypoint or binding: ${token} in ${INPUT}")
        endif()
    endforeach()
    if(NOT shader MATCHES "uint width;[ \t\r\n]+uint rows;[ \t\r\n]+uint use_scale;[ \t\r\n]+float epsilon;")
        message(FATAL_ERROR "RMSNorm parameter layout changed: ${INPUT}")
    endif()
    file(WRITE "${OUTPUT}" "#pragma once\n\nnamespace strix::${backend} {\n"
        "inline constexpr char rms_norm_${MODE}[] = R\"strix_shader(${shader})strix_shader\";\n}\n")
endif()
