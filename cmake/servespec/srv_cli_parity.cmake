# Server / CLI parity: one host gate for every family built here (strix/serve_cli_parity.hpp) and the ratio report tool.
if(BUILD_TESTING)
    add_executable(strix-serve-cli-parity-tests "${CMAKE_SOURCE_DIR}/tests/serve_cli_parity_tests.cpp")
    target_include_directories(strix-serve-cli-parity-tests PRIVATE "${CMAKE_SOURCE_DIR}/include" "${CMAKE_SOURCE_DIR}/apps" "${CMAKE_SOURCE_DIR}/src")
    target_compile_features(strix-serve-cli-parity-tests PRIVATE cxx_std_20)
    target_compile_definitions(strix-serve-cli-parity-tests PRIVATE STRIX_PARITY_GLM=1)  # header-only resolver
    if(MSVC)
        target_compile_definitions(strix-serve-cli-parity-tests PRIVATE _CRT_SECURE_NO_WARNINGS)
        target_compile_options(strix-serve-cli-parity-tests PRIVATE /utf-8)
    endif()
    if(TARGET strix_minimax_defaults)
        target_link_libraries(strix-serve-cli-parity-tests PRIVATE strix_minimax_defaults)
        target_compile_definitions(strix-serve-cli-parity-tests PRIVATE STRIX_PARITY_MINIMAX=1)
    endif()
    if(TARGET strix_ds41_runtime)
        target_link_libraries(strix-serve-cli-parity-tests PRIVATE strix_ds41_runtime)
        target_compile_definitions(strix-serve-cli-parity-tests PRIVATE STRIX_PARITY_DS41=1)
    endif()
    strix_target_warnings(strix-serve-cli-parity-tests)
    add_test(NAME strix-serve-cli-parity-tests COMMAND strix-serve-cli-parity-tests)
    set_tests_properties(strix-serve-cli-parity-tests PROPERTIES TIMEOUT 60)
endif()
strix_servespec_python_test(NAME strix-serve-cli-ratio-tests SCRIPT tests/serve_cli_ratio_tests.py)
