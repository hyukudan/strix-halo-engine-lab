        function(strix_gemma4_route_test app slots arm selection version)
            set(test "gemma4-exl3-route-${app}-${slots}-${arm}-${selection}")
            add_test(NAME ${test} COMMAND strix-gemma4-serve-route-invariance-tests ${app} ${version}
                --model unused-bf16 --rope-tables unused-rope --backend host --profile quality --draft off
                --exl3-arm "${CMAKE_CURRENT_BINARY_DIR}/gemma4-route-${arm}" --print-effective-config)
            set_tests_properties(${test} PROPERTIES TIMEOUT 60 LABELS "cpu;gemma4"
                ENVIRONMENT "STRIX_G4_SERVE_BATCH=1;STRIX_G4_SERVE_SLOTS=${slots};STRIX_G4_EXL3_IDENTITY=${selection}")
        endfunction()
        foreach(app decode serve)
            foreach(slots 1 8)
                if(app STREQUAL "decode" AND slots EQUAL 8)
                    continue()
                endif()
                # Automatic M5 keeps the incumbent crossover (v3 at eight slots); explicit values are slot-invariant.
                if(slots EQUAL 8)
                    strix_gemma4_route_test(${app} ${slots} M5 auto 3)
                else()
                    strix_gemma4_route_test(${app} ${slots} M5 auto 1)
                endif()
                foreach(version 1 2 3)
                    strix_gemma4_route_test(${app} ${slots} M5 v${version} ${version})
                endforeach()
                strix_gemma4_route_test(${app} ${slots} M4 auto 3)
                strix_gemma4_route_test(${app} ${slots} M4 v1 1)
            endforeach()
        endforeach()
    endif()
