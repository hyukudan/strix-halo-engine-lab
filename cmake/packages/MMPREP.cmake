if(BUILD_TESTING)
    add_executable(strix-mmprep-plan-test tests/cuda_core/mmprep_plan_test.cpp)
    target_include_directories(strix-mmprep-plan-test PRIVATE include src)
    target_compile_features(strix-mmprep-plan-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-mmprep-plan-test)
    add_test(NAME strix-mmprep-plan-test COMMAND strix-mmprep-plan-test)
    set_tests_properties(strix-mmprep-plan-test PROPERTIES LABELS "cpu;plan")
endif()

option(STRIX_MMPREP_CUDA_FIXTURE "Build the K6c indexed-prep fixture for sm_120a" OFF)
option(STRIX_MMPREP_DEVICE_TEST "Register the CUDA fixture for operator-run CTest" OFF)
if(STRIX_MMPREP_CUDA_FIXTURE)
    enable_language(CUDA)
    add_executable(strix-mmprep-cuda-fixture tests/cuda_core/mmprep_cuda_fixture.cu)
    target_include_directories(strix-mmprep-cuda-fixture PRIVATE include src)
    set_target_properties(strix-mmprep-cuda-fixture PROPERTIES
        CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES "120a-real")
    target_compile_options(strix-mmprep-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false)
    if(MSVC)
        target_compile_options(strix-mmprep-cuda-fixture PRIVATE -Xcompiler=/EHsc,/Zc:preprocessor,/utf-8,/W4)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmprep-cuda-fixture PRIVATE -Xcompiler=/WX)
        endif()
    else()
        target_compile_options(strix-mmprep-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmprep-cuda-fixture PRIVATE -Xcompiler=-Werror)
        endif()
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-mmprep-cuda-fixture PRIVATE --Werror=all-warnings)
    endif()
    if(BUILD_TESTING AND STRIX_MMPREP_DEVICE_TEST)
        add_test(NAME strix-mmprep-cuda-fixture COMMAND strix-mmprep-cuda-fixture)
        set_tests_properties(strix-mmprep-cuda-fixture PROPERTIES LABELS "gpu;cuda" TIMEOUT 60)
    endif()
endif()
