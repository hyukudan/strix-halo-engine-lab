if(BUILD_TESTING)
    add_executable(strix-k3r-host-test tests/moe_core/route_project_test.cpp)
    target_include_directories(strix-k3r-host-test PRIVATE include)
    target_compile_features(strix-k3r-host-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-k3r-host-test)
    if(MSVC)
        target_compile_options(strix-k3r-host-test PRIVATE /fp:strict)
    else()
        target_compile_options(strix-k3r-host-test PRIVATE -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME strix-k3r-host-test COMMAND strix-k3r-host-test)
    set_tests_properties(strix-k3r-host-test PROPERTIES LABELS "cpu;K3R")
endif()

option(STRIX_K3R_CUDA_FIXTURE "Build the sm_120a route projection byte fixture" OFF)
if(STRIX_K3R_CUDA_FIXTURE)
    enable_language(CUDA)
    # The GPU operator runs this fixture explicitly.
    add_executable(strix-k3r-cuda-fixture tests/cuda_core/k3r_fixture.cu)
    target_include_directories(strix-k3r-cuda-fixture PRIVATE include src)
    set_target_properties(strix-k3r-cuda-fixture PROPERTIES
        CUDA_ARCHITECTURES "120a-real" CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
    target_compile_options(strix-k3r-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false -Xptxas=-v)
    if(MSVC)
        target_compile_options(strix-k3r-cuda-fixture PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-k3r-cuda-fixture PRIVATE -Xcompiler=/WX)
        endif()
    else()
        target_compile_options(strix-k3r-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wpedantic,-Wconversion,-Wshadow)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-k3r-cuda-fixture PRIVATE -Xcompiler=-Werror)
        endif()
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-k3r-cuda-fixture PRIVATE -Werror=all-warnings)
    endif()
endif()
