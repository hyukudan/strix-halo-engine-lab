if(BUILD_TESTING)
    add_executable(strix-f3g-route-policy-test tests/f3g_route_policy_test.cpp)
    target_include_directories(strix-f3g-route-policy-test PRIVATE include)
    target_compile_features(strix-f3g-route-policy-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-f3g-route-policy-test)
    if(MSVC)
        target_compile_options(strix-f3g-route-policy-test PRIVATE /fp:strict)
    else()
        target_compile_options(strix-f3g-route-policy-test PRIVATE -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME strix-f3g-route-policy-test COMMAND strix-f3g-route-policy-test)
    set_tests_properties(strix-f3g-route-policy-test PROPERTIES LABELS "cpu;F3G")
endif()

option(STRIX_F3G_CUDA_FIXTURE "Build the sm_120a gfx1151 route and chain side-output fixture" OFF)
if(STRIX_F3G_CUDA_FIXTURE)
    enable_language(CUDA)
    # Explicit operator run with gfx1151 probe tables. Never register with CTest.
    add_executable(strix-f3g-cuda-fixture tests/cuda_core/f3g_fixture.cu src/cuda/core/amd_math_tables.cu)
    target_include_directories(strix-f3g-cuda-fixture PRIVATE include src)
    set_target_properties(strix-f3g-cuda-fixture PROPERTIES
        CUDA_ARCHITECTURES "120a-real" CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
    target_compile_options(strix-f3g-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false -Xptxas=-v)
    if(MSVC)
        target_compile_options(strix-f3g-cuda-fixture PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
        set(f3g_host_werror -Xcompiler=/WX)
    else()
        target_compile_options(strix-f3g-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wpedantic,-Wconversion,-Wshadow)
        set(f3g_host_werror -Xcompiler=-Werror)
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-f3g-cuda-fixture PRIVATE ${f3g_host_werror} -Werror=all-warnings)
    endif()
    unset(f3g_host_werror)
endif()
