if(BUILD_TESTING)
    add_executable(strix-mmattn-plan-test tests/cuda_core/mmattn_plan_test.cpp)
    target_include_directories(strix-mmattn-plan-test PRIVATE src)
    target_compile_features(strix-mmattn-plan-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-mmattn-plan-test)
    add_test(NAME strix-mmattn-plan-test COMMAND strix-mmattn-plan-test)
    set_tests_properties(strix-mmattn-plan-test PROPERTIES LABELS "cpu;plan")
endif()

option(STRIX_MMATTN_CUDA_FIXTURE "Compile the selected-block CUDA attention fixture for sm_120a" OFF)
option(STRIX_MMATTN_DEVICE_TEST "Register the selected-block CUDA fixture for operator-run CTest" OFF)
if(STRIX_MMATTN_CUDA_FIXTURE)
    enable_language(CUDA)
    add_executable(strix-mmattn-cuda-fixture tests/cuda_core/mmattn_cuda_fixture.cu)
    target_include_directories(strix-mmattn-cuda-fixture PRIVATE src)
    set_target_properties(strix-mmattn-cuda-fixture PROPERTIES
        CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES 120a-real)
    target_compile_options(strix-mmattn-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false)
    if(MSVC)
        target_compile_options(strix-mmattn-cuda-fixture PRIVATE -Xcompiler=/EHsc,/Zc:preprocessor,/utf-8,/W4)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmattn-cuda-fixture PRIVATE -Xcompiler=/WX)
        endif()
    else()
        target_compile_options(strix-mmattn-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmattn-cuda-fixture PRIVATE -Xcompiler=-Werror)
        endif()
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-mmattn-cuda-fixture PRIVATE --Werror=all-warnings)
    endif()
    if(BUILD_TESTING AND STRIX_MMATTN_DEVICE_TEST)
        add_test(NAME strix-mmattn-cuda-fixture COMMAND strix-mmattn-cuda-fixture)
        set_tests_properties(strix-mmattn-cuda-fixture PROPERTIES LABELS "gpu;cuda" TIMEOUT 60)
    endif()
endif()
