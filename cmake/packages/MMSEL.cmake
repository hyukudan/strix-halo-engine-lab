if(BUILD_TESTING)
    add_executable(strix-mmsel-host-test tests/moe_core/route_score_planes_test.cpp)
    target_include_directories(strix-mmsel-host-test PRIVATE include tests/cuda_core)
    target_compile_features(strix-mmsel-host-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-mmsel-host-test)
    if(MSVC)
        target_compile_options(strix-mmsel-host-test PRIVATE /fp:strict)
    else()
        target_compile_options(strix-mmsel-host-test PRIVATE -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME strix-mmsel-host-test COMMAND strix-mmsel-host-test)
    set_tests_properties(strix-mmsel-host-test PROPERTIES LABELS "cpu;MMSEL")
endif()

option(STRIX_MMSEL_CUDA_FIXTURE "Build the sm_120a score plane selection byte fixture" OFF)
if(STRIX_MMSEL_CUDA_FIXTURE)
    enable_language(CUDA)
    # Device operators run the fixture explicitly.
    add_executable(strix-mmsel-cuda-fixture tests/cuda_core/mmsel_fixture.cu)
    target_include_directories(strix-mmsel-cuda-fixture PRIVATE include src)
    set_target_properties(strix-mmsel-cuda-fixture PROPERTIES
        CUDA_ARCHITECTURES "120a-real" CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
    target_compile_options(strix-mmsel-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false -Xptxas=-v)
    if(MSVC)
        target_compile_options(strix-mmsel-cuda-fixture PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmsel-cuda-fixture PRIVATE -Xcompiler=/WX)
        endif()
    else()
        target_compile_options(strix-mmsel-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wpedantic,-Wconversion,-Wshadow)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-mmsel-cuda-fixture PRIVATE -Xcompiler=-Werror)
        endif()
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-mmsel-cuda-fixture PRIVATE -Werror=all-warnings)
    endif()
endif()
