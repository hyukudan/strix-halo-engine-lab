if(BUILD_TESTING)
    add_executable(weight_decoder_conformance tests/weight_decoder_tests.cpp)
    target_include_directories(weight_decoder_conformance PRIVATE src)
    target_link_libraries(weight_decoder_conformance PRIVATE strix-weight)
    strix_target_warnings(weight_decoder_conformance)
    if(MSVC)
        target_compile_options(weight_decoder_conformance PRIVATE /fp:strict)
    else()
        target_compile_options(weight_decoder_conformance PRIVATE -ffp-contract=off)
    endif()
    add_test(NAME weight_decoder_conformance COMMAND weight_decoder_conformance)
    set_tests_properties(weight_decoder_conformance PROPERTIES LABELS cpu)

    add_executable(weight_chunk_traits tests/weight_chunk_traits.cpp)
    # core/weight_decode.hpp includes strix/weight/host_lowbit.hpp (q4_g64 / q6_g64 storages).
    target_include_directories(weight_chunk_traits PRIVATE src include)
    target_compile_features(weight_chunk_traits PRIVATE cxx_std_20)
    strix_target_warnings(weight_chunk_traits)
    add_test(NAME weight_chunk_traits COMMAND weight_chunk_traits)
    set_tests_properties(weight_chunk_traits PROPERTIES LABELS cpu)
endif()
