if(BUILD_TESTING)
    add_executable(strix-b8-route-plan-test tests/moe_core/b8_route_plan_test.cpp)
    target_include_directories(strix-b8-route-plan-test PRIVATE include src)
    target_compile_features(strix-b8-route-plan-test PRIVATE cxx_std_20)
    strix_target_warnings(strix-b8-route-plan-test)
    if(MSVC)
        target_compile_options(strix-b8-route-plan-test PRIVATE /fp:strict)
    else()
        target_compile_options(strix-b8-route-plan-test PRIVATE -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME strix-b8-route-plan-test COMMAND strix-b8-route-plan-test)
    set_tests_properties(strix-b8-route-plan-test PROPERTIES LABELS "cpu;plan")
endif()

option(STRIX_B8_CUDA_FIXTURE "Build the B8 CUDA R1 bitwise fixture" OFF)
if(STRIX_B8_CUDA_FIXTURE)
    enable_language(CUDA)
    add_executable(strix-b8-cuda-fixture tests/cuda_core/b8_route_fixture.cu)
    target_include_directories(strix-b8-cuda-fixture PRIVATE include src)
    set_target_properties(strix-b8-cuda-fixture PROPERTIES
        CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES 120a-real)
    target_compile_options(strix-b8-cuda-fixture PRIVATE
        --fmad=false --prec-div=true --prec-sqrt=true --ftz=false -Xptxas=-v)
    if(MSVC)
        target_compile_options(strix-b8-cuda-fixture PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-b8-cuda-fixture PRIVATE -Xcompiler=/WX)
        endif()
    else()
        target_compile_options(strix-b8-cuda-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow)
        if(STRIX_WARNINGS_AS_ERRORS)
            target_compile_options(strix-b8-cuda-fixture PRIVATE -Xcompiler=-Werror)
        endif()
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix-b8-cuda-fixture PRIVATE --Werror=all-warnings)
    endif()
    # Native execution is an explicit operator step outside the CPU test suite.
endif()
