if(BUILD_TESTING)
    add_executable(strix-k5c-select-oracle tests/cuda_core/select_oracle_tests.cpp)
    target_include_directories(strix-k5c-select-oracle PRIVATE src)
    target_compile_features(strix-k5c-select-oracle PRIVATE cxx_std_20)
    strix_target_warnings(strix-k5c-select-oracle)
    if(MSVC)
        target_compile_options(strix-k5c-select-oracle PRIVATE /fp:strict)
    else()
        target_compile_options(strix-k5c-select-oracle PRIVATE -ffp-contract=off)
    endif()
    add_test(NAME strix-k5c-select-oracle COMMAND strix-k5c-select-oracle)
    set_tests_properties(strix-k5c-select-oracle PROPERTIES LABELS "cpu")
endif()

option(STRIX_K5C_CUDA_FIXTURE "Build the K5c selection fixture for sm_120a" OFF)
if(STRIX_K5C_CUDA_FIXTURE)
    enable_language(CUDA)
    include(tests/cuda_core/select_incumbents.cmake)
    add_executable(strix-k5c-select-fixture tests/cuda_core/select_cuda_fixture.cu)
    target_include_directories(strix-k5c-select-fixture PRIVATE src include "${CMAKE_CURRENT_BINARY_DIR}/k5c")
    set_target_properties(strix-k5c-select-fixture PROPERTIES
        CUDA_ARCHITECTURES 120a-real CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
    target_compile_options(strix-k5c-select-fixture PRIVATE
        $<$<COMPILE_LANGUAGE:CUDA>:--fmad=false;--prec-div=true;--prec-sqrt=true;--ftz=false;--Werror=all-warnings>)
    if(MSVC)
        target_compile_options(strix-k5c-select-fixture PRIVATE
            $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/EHsc,/Zc:preprocessor,/utf-8,/W4,/WX>)
    endif()
    # The fixture runs only by explicit operator invocation.
endif()
