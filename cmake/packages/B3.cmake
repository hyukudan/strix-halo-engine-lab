add_library(strix_row_epilogue_plan STATIC src/exec/row_epilogue_plan.cpp)
target_link_libraries(strix_row_epilogue_plan PUBLIC strix_exec_catalog strix_stage_graph)
target_compile_features(strix_row_epilogue_plan PUBLIC cxx_std_20)
strix_target_warnings(strix_row_epilogue_plan)

if(BUILD_TESTING)
    add_executable(strix-row-epilogue-plan-tests tests/row_epilogue_plan_tests.cpp)
    target_include_directories(strix-row-epilogue-plan-tests PRIVATE src)
    target_link_libraries(strix-row-epilogue-plan-tests PRIVATE strix_row_epilogue_plan strix_exec)
    strix_target_warnings(strix-row-epilogue-plan-tests)
    add_test(NAME exec_row_epilogue_plan COMMAND strix-row-epilogue-plan-tests)
    set_tests_properties(exec_row_epilogue_plan PROPERTIES LABELS "cpu;plan;B3" TIMEOUT 30)
endif()

option(STRIX_B3_CUDA_FIXTURE "Build the CUDA row epilogue chain fixture" OFF)
if(STRIX_B3_CUDA_FIXTURE)
    enable_language(CUDA)
    add_executable(strix-b3-cuda-chain-fixture tests/cuda_core/row_epilogue_chain_fixture.cu)
    target_include_directories(strix-b3-cuda-chain-fixture PRIVATE include src)
    set_target_properties(strix-b3-cuda-chain-fixture PROPERTIES
        CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES 120a-real)
    target_compile_options(strix-b3-cuda-chain-fixture PRIVATE --fmad=false --prec-div=true --prec-sqrt=true --ftz=false)
    if(MSVC)
        target_compile_options(strix-b3-cuda-chain-fixture PRIVATE -Xcompiler=/W4,/WX,/EHsc,/Zc:preprocessor,/utf-8)
    else()
        target_compile_options(strix-b3-cuda-chain-fixture PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow,-Werror)
    endif()
endif()
