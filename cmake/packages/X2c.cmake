if(BUILD_TESTING)
    add_executable(strix-exec-cuda-key-tests tests/exec_cuda_key_tests.cpp)
    target_include_directories(strix-exec-cuda-key-tests PRIVATE include src/exec)
    target_compile_features(strix-exec-cuda-key-tests PRIVATE cxx_std_20)
    strix_target_warnings(strix-exec-cuda-key-tests)
    add_test(NAME exec_cuda_keys COMMAND strix-exec-cuda-key-tests)
    set_tests_properties(exec_cuda_keys PROPERTIES LABELS "cpu;plan" TIMEOUT 30)
endif()

option(STRIX_EXEC_CUDA "Build the shared CUDA program executor and its fixture" OFF)
if(STRIX_EXEC_CUDA)
    set(STRIX_EXEC_CUDA_ARCHITECTURES "90" CACHE STRING "CUDA architectures for the program executor (PDL requires 90+)")
    enable_language(CUDA)
    if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13)
        message(FATAL_ERROR "STRIX_EXEC_CUDA requires CUDA Toolkit 13 for graph capture edge data")
    endif()

    add_library(strix_exec_cuda STATIC src/exec/executor_cuda.cu)
    if(BUILD_TESTING)
        target_compile_definitions(strix_exec_cuda PRIVATE STRIX_STRICT_GRAPH_CAPTURE=1)
    endif()
    target_include_directories(strix_exec_cuda PUBLIC include src/exec)
    target_compile_features(strix_exec_cuda PUBLIC cxx_std_20)
    set_target_properties(strix_exec_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON
        CUDA_ARCHITECTURES "${STRIX_EXEC_CUDA_ARCHITECTURES}")

    if(BUILD_TESTING)
        # Built with the package. Run explicitly on a qualified CUDA node.
        add_executable(strix-exec-no-recapture tests/exec_no_recapture.cu)
        target_link_libraries(strix-exec-no-recapture PRIVATE strix_exec_cuda)
        target_include_directories(strix-exec-no-recapture PRIVATE src)
        set_target_properties(strix-exec-no-recapture PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON
            CUDA_ARCHITECTURES "${STRIX_EXEC_CUDA_ARCHITECTURES}")
    endif()

    foreach(x2c_target strix_exec_cuda strix-exec-no-recapture)
        if(TARGET ${x2c_target})
            if(MSVC)
                target_compile_options(${x2c_target} PRIVATE -Xcompiler=/W4,/EHsc)
                set(x2c_host_werror -Xcompiler=/WX)
            else()
                target_compile_options(${x2c_target} PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow)
                set(x2c_host_werror -Xcompiler=-Werror)
            endif()
            if(STRIX_WARNINGS_AS_ERRORS)
                target_compile_options(${x2c_target} PRIVATE ${x2c_host_werror} -Werror=all-warnings)
            endif()
        endif()
    endforeach()
endif()
