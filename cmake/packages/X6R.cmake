if(BUILD_TESTING)
    add_executable(strix-x6-step-profile-tests tests/x6_step_profile_report_tests.cpp)
    target_include_directories(strix-x6-step-profile-tests PRIVATE src)
    target_link_libraries(strix-x6-step-profile-tests PRIVATE strix_exec_profiler)
    target_compile_features(strix-x6-step-profile-tests PRIVATE cxx_std_20)
    strix_target_warnings(strix-x6-step-profile-tests)
    set(x6_step_profile_receipts "${CMAKE_CURRENT_BINARY_DIR}/x6-step-profile-receipts/$<CONFIG>")
    add_test(NAME x6_step_profile_host COMMAND strix-x6-step-profile-tests "${x6_step_profile_receipts}")
    set_tests_properties(x6_step_profile_host PROPERTIES FIXTURES_SETUP x6_step_profile_receipt LABELS "host;X6" TIMEOUT 30)
    find_package(Python3 3.11 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        add_test(NAME x6_step_profile_receipt_schema COMMAND "${Python3_EXECUTABLE}" -B
            "${CMAKE_CURRENT_SOURCE_DIR}/tools/receipt-schema/check.py" "${x6_step_profile_receipts}/receipt.json")
        set_tests_properties(x6_step_profile_receipt_schema PROPERTIES FIXTURES_REQUIRED x6_step_profile_receipt LABELS "host;R1" TIMEOUT 30)
    endif()
    unset(x6_step_profile_receipts)
endif()
