if(TARGET strix_exec_cuda)
    add_library(strix_exec_profiler_cuda STATIC src/exec/profiler_cuda.cu)
    target_link_libraries(strix_exec_profiler_cuda PUBLIC strix_exec_profiler strix_exec_cuda PRIVATE strix_device)
    if(TARGET strix_cuda_core_kernels)
        target_compile_definitions(strix_exec_profiler_cuda PRIVATE STRIX_X6_CUDA_CATALOGUE)
        target_link_libraries(strix_exec_profiler_cuda PRIVATE strix_exec_catalog strix_cuda_core_kernels)
    endif()
    target_compile_definitions(strix-bench PRIVATE STRIX_X6_CUDA)
    target_link_libraries(strix-bench PRIVATE strix_exec_profiler_cuda)

    if(BUILD_TESTING)
        # Operator fixture. Never registered with CTest.
        add_executable(strix-x6-cuda-fixture tests/x6_profiler_cuda.cu)
        target_link_libraries(strix-x6-cuda-fixture PRIVATE strix_exec_profiler_cuda strix_device)
    endif()

    foreach(target strix_exec_profiler_cuda strix-x6-cuda-fixture)
        if(TARGET ${target})
            set_target_properties(${target} PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON
                CUDA_ARCHITECTURES "${STRIX_EXEC_CUDA_ARCHITECTURES}")
            if(MSVC)
                target_compile_options(${target} PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
                if(STRIX_WARNINGS_AS_ERRORS)
                    target_compile_options(${target} PRIVATE -Xcompiler=/WX)
                endif()
            else()
                target_compile_options(${target} PRIVATE -Xcompiler=-Wall,-Wextra,-Wpedantic,-Wconversion,-Wshadow)
                if(STRIX_WARNINGS_AS_ERRORS)
                    target_compile_options(${target} PRIVATE -Xcompiler=-Werror)
                endif()
            endif()
            if(STRIX_WARNINGS_AS_ERRORS)
                target_compile_options(${target} PRIVATE -Werror=all-warnings)
            endif()
        endif()
    endforeach()
endif()

