    add_executable(strix-x6-profiler-tests tests/x6_profiler_tests.cpp)
    target_link_libraries(strix-x6-profiler-tests PRIVATE strix_exec_profiler)
    strix_target_warnings(strix-x6-profiler-tests)
    set(x6_receipt_dir "${CMAKE_CURRENT_BINARY_DIR}/x6-receipts/$<CONFIG>")
    add_test(NAME x6_profiler_host COMMAND strix-x6-profiler-tests "${x6_receipt_dir}")
    set_tests_properties(x6_profiler_host PROPERTIES FIXTURES_SETUP x6_receipt LABELS "host;X6" TIMEOUT 30)
    find_package(Python3 3.11 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        add_test(NAME x6_receipt_schema COMMAND "${Python3_EXECUTABLE}" -B
            "${CMAKE_CURRENT_SOURCE_DIR}/tools/receipt-schema/check.py"
            "${x6_receipt_dir}/cpu-stub.json" "${x6_receipt_dir}/timed.json")
        set_tests_properties(x6_receipt_schema PROPERTIES FIXTURES_REQUIRED x6_receipt LABELS "host;X6" TIMEOUT 30)
        if(NOT TARGET strix_exec_cuda)
            add_test(NAME x6_bench_cli COMMAND "${Python3_EXECUTABLE}" -B
                "${CMAKE_CURRENT_SOURCE_DIR}/tests/x6_bench_cli.py" "$<TARGET_FILE:strix-bench>")
            set_tests_properties(x6_bench_cli PROPERTIES LABELS "host;R3" TIMEOUT 30)
        endif()
    endif()
    unset(x6_receipt_dir)
