if(BUILD_TESTING AND TARGET strix_model_decl)
    add_executable(strix-inkling2-program-tests
        tests/inkling2/program_tests.cpp
        src/exec/scheduled_stage_graph.cpp)
    target_include_directories(strix-inkling2-program-tests PRIVATE src)
    target_link_libraries(strix-inkling2-program-tests PRIVATE strix_exec strix_model_decl)
    strix_target_warnings(strix-inkling2-program-tests)
    add_test(NAME inkling2_program_host COMMAND strix-inkling2-program-tests
        "${CMAKE_CURRENT_SOURCE_DIR}/data/graph/templates"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/data/model_decl/inkling2-mini.toml")
    set_tests_properties(inkling2_program_host PROPERTIES LABELS "cpu;plan;inkling2" TIMEOUT 30)
endif()

if(TARGET strix_exec_cuda AND TARGET strix_cuda_core_kernels)
    set(e1x_catalog_archs "${STRIX_EXEC_CUDA_ARCHITECTURES}")
    if(TARGET strix-inkling2-mini-cuda)
        # Header-defined kernels must select the same device code in both routes.
        get_target_property(e1x_catalog_archs strix-inkling2-mini-cuda CUDA_ARCHITECTURES)
    endif()
    add_library(strix_exec_cuda_decode_catalog STATIC src/exec/catalog_cuda_decode.cu)
    target_include_directories(strix_exec_cuda_decode_catalog PRIVATE include src)
    target_link_libraries(strix_exec_cuda_decode_catalog PRIVATE strix_cuda_core_kernels strix_exec_catalog)
    set_target_properties(strix_exec_cuda_decode_catalog PROPERTIES
        CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES "${e1x_catalog_archs}")
    target_compile_options(strix_exec_cuda_decode_catalog PRIVATE --fmad=false --prec-div=true --prec-sqrt=true --ftz=false)
    if(MSVC)
        target_compile_options(strix_exec_cuda_decode_catalog PRIVATE -Xcompiler=/W4,/EHsc,/Zc:preprocessor,/utf-8)
        set(e1x_host_werror -Xcompiler=/WX)
    else()
        target_compile_options(strix_exec_cuda_decode_catalog PRIVATE -Xcompiler=-Wall,-Wextra,-Wconversion,-Wshadow)
        set(e1x_host_werror -Xcompiler=-Werror)
    endif()
    if(STRIX_WARNINGS_AS_ERRORS)
        target_compile_options(strix_exec_cuda_decode_catalog PRIVATE ${e1x_host_werror} -Werror=all-warnings)
    endif()
    if(TARGET strix-inkling2-mini-cuda)
        target_compile_definitions(strix-inkling2-mini-cuda PRIVATE STRIX_INKLING2_STEP_PROGRAM=1)
        target_link_libraries(strix-inkling2-mini-cuda PRIVATE strix_exec strix_exec_cuda strix_exec_cuda_decode_catalog)
    endif()
    if(BUILD_TESTING)
        # Host only: bind() records launches, nothing runs on a GPU.
        add_executable(strix-cuda-decode-forms-tests tests/exec/cuda_decode_forms_tests.cpp)
        target_include_directories(strix-cuda-decode-forms-tests PRIVATE include src)
        target_link_libraries(strix-cuda-decode-forms-tests PRIVATE strix_exec strix_exec_cuda_decode_catalog)
        target_compile_features(strix-cuda-decode-forms-tests PRIVATE cxx_std_20)
        strix_target_warnings(strix-cuda-decode-forms-tests)
        add_test(NAME cuda_decode_forms_host COMMAND strix-cuda-decode-forms-tests)
        set_tests_properties(cuda_decode_forms_host PROPERTIES LABELS "cpu;plan" TIMEOUT 30)
    endif()
    if(TARGET strix-inkling2-program-tests)
        target_compile_definitions(strix-inkling2-program-tests PRIVATE STRIX_INKLING2_TEST_CUDA_BINDINGS=1)
        target_link_libraries(strix-inkling2-program-tests PRIVATE strix_exec_cuda_decode_catalog)
    endif()
    if(TARGET cuda_core_k1bind_test)
        target_compile_definitions(cuda_core_k1bind_test PRIVATE STRIX_TEST_K1_RECIPE=1)
        target_link_libraries(cuda_core_k1bind_test PRIVATE strix_exec strix_exec_cuda_decode_catalog)
    endif()
endif()
