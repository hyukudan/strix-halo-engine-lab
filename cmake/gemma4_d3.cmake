# Product device sessions and stream-local policy. Other package targets remain unchanged.
target_sources(strix_gemma4_engine PRIVATE src/gemma4/engine/auto_policy.cpp src/gemma4/engine/lookup.cpp
    src/gemma4/engine/lookup_session.cpp)
add_executable(strix-gemma4-gate apps/gemma4_gate_main.cpp)
target_link_libraries(strix-gemma4-gate PRIVATE strix_gemma4_engine)
strix_target_warnings(strix-gemma4-gate)
if(STRIX_GEMMA4_DEVICE_BACKEND)
    # Exact many-row prompt prefill (prefill::DevicePrefill with Linears::exact).
    target_link_libraries(strix_gemma4_engine PUBLIC strix_gemma4_dflash_device strix_gemma4_prefill)
else()
    add_library(strix_gemma4_engine_device_host_compile OBJECT EXCLUDE_FROM_ALL src/gemma4/engine/device_backend.cpp)
    target_link_libraries(strix_gemma4_engine_device_host_compile PRIVATE strix_gemma4_engine)
    target_compile_definitions(strix_gemma4_engine_device_host_compile PRIVATE STRIX_GEMMA4_DEVICE_BACKEND=1)
    if(MSVC)
        target_compile_definitions(strix_gemma4_engine_device_host_compile PRIVATE _CRT_SECURE_NO_WARNINGS)
    endif()
    strix_target_warnings(strix_gemma4_engine_device_host_compile)
endif()
if(BUILD_TESTING)
    add_executable(strix-gemma4-auto-policy-tests tests/gemma4_integration/policy.cpp)
    target_link_libraries(strix-gemma4-auto-policy-tests PRIVATE strix_gemma4_engine)
    strix_target_warnings(strix-gemma4-auto-policy-tests)
    add_test(NAME gemma4-integration-auto-policy COMMAND strix-gemma4-auto-policy-tests)
    set_tests_properties(gemma4-integration-auto-policy PROPERTIES TIMEOUT 60)
    add_test(NAME gemma4-integration-forced COMMAND strix-gemma4-integration-tests --forced)
    set_tests_properties(gemma4-integration-forced PROPERTIES TIMEOUT 60 ENVIRONMENT "STRIX_G4_DFLASH=on")
endif()
