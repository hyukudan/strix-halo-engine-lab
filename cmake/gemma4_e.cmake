# Separate numerical prefill identity; never changes the g4-v1 decode library.
add_library(strix_gemma4_prefill_host STATIC src/gemma4/prefill/host.cpp src/gemma4/prefill/emulator.cpp src/gemma4/prefill/reference.cpp src/gemma4/prefill/attention.cpp)
target_link_libraries(strix_gemma4_prefill_host PUBLIC strix_gemma4_ref)
strix_target_warnings(strix_gemma4_prefill_host)
if(MSVC)
    target_compile_definitions(strix_gemma4_prefill_host PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
if(BUILD_TESTING)
    add_executable(strix-gemma4-prefill-host-tests tests/gemma4_prefill/host.cpp)
    target_link_libraries(strix-gemma4-prefill-host-tests PRIVATE strix_gemma4_prefill_host)
    strix_target_warnings(strix-gemma4-prefill-host-tests)
    add_test(NAME strix-gemma4-prefill-host-tests COMMAND strix-gemma4-prefill-host-tests)
    set_tests_properties(strix-gemma4-prefill-host-tests PROPERTIES TIMEOUT 60)
    foreach(part emulator reference attention)
        add_executable(strix-gemma4-prefill-${part}-tests tests/gemma4_prefill/${part}.cpp)
        target_link_libraries(strix-gemma4-prefill-${part}-tests PRIVATE strix_gemma4_prefill_host)
        target_compile_definitions(strix-gemma4-prefill-${part}-tests PRIVATE G4_PREFILL_FIXTURE="${CMAKE_CURRENT_SOURCE_DIR}/tests/gemma4_prefill/fixtures/instructions.bin")
        strix_target_warnings(strix-gemma4-prefill-${part}-tests)
        add_test(NAME strix-gemma4-prefill-${part}-tests COMMAND strix-gemma4-prefill-${part}-tests)
        set_tests_properties(strix-gemma4-prefill-${part}-tests PROPERTIES TIMEOUT 60)
    endforeach()
    if(NOT STRIX_ENABLE_HIP_RUNTIME)
        add_library(strix_gemma4_prefill_host_compile OBJECT EXCLUDE_FROM_ALL tests/gemma4_prefill/device.cpp tests/gemma4_prefill/attention_device.cpp tests/gemma4_prefill/canonical_device.cpp src/gemma4/prefill/check_main.cpp src/gemma4/prefill/qualification.cpp)
        target_link_libraries(strix_gemma4_prefill_host_compile PRIVATE strix_gemma4_prefill_host strix_gemma4_ref)
        strix_target_warnings(strix_gemma4_prefill_host_compile)
    endif()
endif()
if(STRIX_ENABLE_HIP_RUNTIME)
    add_library(strix_gemma4_prefill STATIC src/gemma4/prefill/linear.hip src/gemma4/prefill/target.hip src/gemma4/prefill/attention.hip src/gemma4/prefill/canonical.hip)
    target_link_libraries(strix_gemma4_prefill PUBLIC strix_gemma4_prefill_host strix_gemma4_device_primitives strix_gemma4_ref)
    set(g4_e_hip_targets strix_gemma4_prefill)
    add_executable(strix-gemma4-prefill-check src/gemma4/prefill/check_main.cpp src/gemma4/prefill/qualification.cpp)
    target_link_libraries(strix-gemma4-prefill-check PRIVATE strix_gemma4_prefill strix_gemma4_device strix_gemma4_dflash_device)
    strix_target_warnings(strix-gemma4-prefill-check)
    add_executable(strix-gemma4-prefill-characterize tests/gemma4_prefill/characterize.hip)
    target_link_libraries(strix-gemma4-prefill-characterize PRIVATE "${STRIX_HIP_RUNTIME_LIBRARY}")
    target_include_directories(strix-gemma4-prefill-characterize PRIVATE "${STRIX_HIP_INCLUDE_DIR}")
    list(APPEND g4_e_hip_targets strix-gemma4-prefill-characterize)
    add_executable(strix-gemma4-prefill-matrix-bench tests/gemma4_prefill/bench.hip)
    target_link_libraries(strix-gemma4-prefill-matrix-bench PRIVATE strix_gemma4_prefill strix_gemma4_device)
    list(APPEND g4_e_hip_targets strix-gemma4-prefill-matrix-bench)
    if(BUILD_TESTING)
        add_executable(strix-gemma4-prefill-attention-device-tests tests/gemma4_prefill/attention_device.cpp)
        target_link_libraries(strix-gemma4-prefill-attention-device-tests PRIVATE strix_gemma4_prefill strix_gemma4_device)
        strix_target_warnings(strix-gemma4-prefill-attention-device-tests)
        add_test(NAME strix-gemma4-prefill-attention-device-tests COMMAND strix-gemma4-prefill-attention-device-tests)
        set_tests_properties(strix-gemma4-prefill-attention-device-tests PROPERTIES TIMEOUT 60 LABELS "gpu;gemma4")
        add_executable(strix-gemma4-prefill-canonical-device-tests tests/gemma4_prefill/canonical_device.cpp)
        target_link_libraries(strix-gemma4-prefill-canonical-device-tests PRIVATE strix_gemma4_prefill strix_gemma4_device)
        strix_target_warnings(strix-gemma4-prefill-canonical-device-tests)
        add_test(NAME strix-gemma4-prefill-canonical-device-tests COMMAND strix-gemma4-prefill-canonical-device-tests)
        set_tests_properties(strix-gemma4-prefill-canonical-device-tests PROPERTIES TIMEOUT 120 LABELS "gpu;gemma4")
        add_executable(strix-gemma4-prefill-device-tests tests/gemma4_prefill/device.cpp)
        target_link_libraries(strix-gemma4-prefill-device-tests PRIVATE strix_gemma4_prefill strix_gemma4_device)
        strix_target_warnings(strix-gemma4-prefill-device-tests)
        add_test(NAME strix-gemma4-prefill-device-tests COMMAND strix-gemma4-prefill-device-tests)
        set_tests_properties(strix-gemma4-prefill-device-tests PROPERTIES TIMEOUT 60 LABELS "gpu;gemma4")
        add_test(NAME strix-gemma4-prefill-device-tiling-off-tests COMMAND strix-gemma4-prefill-device-tests)
        set_tests_properties(strix-gemma4-prefill-device-tiling-off-tests PROPERTIES TIMEOUT 60 LABELS "gpu;gemma4" ENVIRONMENT "STRIX_G4_PREFILL_TILING=0")
    endif()
    foreach(t IN LISTS g4_e_hip_targets)
        set_target_properties(${t} PROPERTIES HIP_STANDARD 20 HIP_STANDARD_REQUIRED ON HIP_ARCHITECTURES gfx1151)
        target_compile_options(${t} PRIVATE $<$<COMPILE_LANGUAGE:HIP>:-mno-wavefrontsize64;-fno-fast-math;-ffp-contract=off;-fhip-fp32-correctly-rounded-divide-sqrt;-fdenormal-fp-math=ieee;-fno-gpu-flush-denormals-to-zero>)
        get_target_property(g4_e_sources ${t} SOURCES)
        foreach(source IN LISTS g4_e_sources)
            if(source MATCHES "\\.hip$")
                set_property(SOURCE ${source} APPEND PROPERTY COMPILE_OPTIONS -fno-rounding-math)
            endif()
        endforeach()
        strix_target_warnings(${t})
    endforeach()
endif()
