# Public metadata is a strict allowlist, never raw cache or compiler flags.
option(STRIX_EMBED_BUILD_INFO "Embed sanitized configured build identity" ON)
# Source archives have no Git metadata: the packager may supply the verified commit.
set(STRIX_SOURCE_GIT_SHA "" CACHE STRING "Full commit SHA of a source archive build (used only without Git metadata)")
set(STRIX_BUILD_JSON "{\"format\":\"strix-build\",\"revision\":1,\"status\":\"unavailable\"}")
if(STRIX_EMBED_BUILD_INFO)
    set(_sha "null")
    set(_dirty "null")
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE _top OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" _source)
        if(_top STREQUAL _source)
            execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${_source}"
                OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            string(LENGTH "${_head}" _length)
            if(_length EQUAL 40 AND _head MATCHES "^[0-9a-f]+$")
                set(_sha "\"${_head}\"")
                execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=normal
                    WORKING_DIRECTORY "${_source}" OUTPUT_VARIABLE _status RESULT_VARIABLE _result ERROR_QUIET)
                if(_result EQUAL 0)
                    if(_status STREQUAL "")
                        set(_dirty false)
                    else()
                        set(_dirty true)
                    endif()
                endif()
            endif()
        endif()
    endif()
    set(_sha_source "\"git\"")
    if(_sha STREQUAL "null")
        set(_sha_source "null")
        string(LENGTH "${STRIX_SOURCE_GIT_SHA}" _length)
        if(_length EQUAL 40 AND STRIX_SOURCE_GIT_SHA MATCHES "^[0-9a-f]+$")
            set(_sha "\"${STRIX_SOURCE_GIT_SHA}\"")
            set(_sha_source "\"supplied\"")
        elseif(NOT STRIX_SOURCE_GIT_SHA STREQUAL "")
            message(WARNING "STRIX_SOURCE_GIT_SHA must be a full lowercase 40-hex commit; build identity keeps git_sha null")
        endif()
    endif()
    set(_options "")
    foreach(_key STRIX_EMBED_BUILD_INFO STRIX_ENABLE_HIP_RUNTIME STRIX_WARNINGS_AS_ERRORS
        STRIX_FAMILY_DEEPSEEK41 STRIX_FAMILY_MINIMAX STRIX_ENABLE_CUDA_DS41 STRIX_ENABLE_CUDA_TRELLIS
        STRIX_USE_OPENSSL_SHA256 STRIX_ENABLE_EXPERIMENTAL_Q4K_A8_RUNTIME STRIX_BUILD_EXPERIMENTAL_Q4K_A8_PROBE
        STRIX_ENABLE_EXPERIMENTAL_DENSE_TRELLIS STRIX_CHECK_KERNEL_SCRATCH STRIX_CUDA_DS41_ONLY)
        if(NOT _options STREQUAL "")
            string(APPEND _options ",")
        endif()
        if(${_key})
            string(APPEND _options "\"${_key}\":true")
        else()
            string(APPEND _options "\"${_key}\":false")
        endif()
    endforeach()
    set(_isas "")
    set(_targets_isa "")
    # A cached architecture list is not an active target when HIP is not compiled.
    if(CMAKE_HIP_COMPILER_LOADED)
        set(_targets_isa ${CMAKE_HIP_ARCHITECTURES})
        get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
        foreach(_target IN LISTS _targets)
            get_target_property(_target_isa ${_target} HIP_ARCHITECTURES)
            if(_target_isa)
                list(APPEND _targets_isa ${_target_isa})
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES _targets_isa)
    list(SORT _targets_isa)
    foreach(_isa IN LISTS _targets_isa)
        if(_isa MATCHES "^gfx[0-9a-f]+(:sramecc[+-]|:xnack[+-])*$")
            if(NOT _isas STREQUAL "")
                string(APPEND _isas ",")
            endif()
            string(APPEND _isas "\"${_isa}\"")
        endif()
    endforeach()
    set(_compiler "null")
    set(_compiler_version "null")
    if(CMAKE_CXX_COMPILER_ID MATCHES "^[A-Za-z0-9_]+$")
        set(_compiler "\"${CMAKE_CXX_COMPILER_ID}\"")
    endif()
    if(CMAKE_CXX_COMPILER_VERSION MATCHES "^[0-9.]+$")
        set(_compiler_version "\"${CMAKE_CXX_COMPILER_VERSION}\"")
    endif()
    set(_hip_compiler "null")
    set(_hip_compiler_version "null")
    if(CMAKE_HIP_COMPILER_LOADED)
        if(CMAKE_HIP_COMPILER_ID MATCHES "^[A-Za-z0-9_]+$")
            set(_hip_compiler "\"${CMAKE_HIP_COMPILER_ID}\"")
        endif()
        if(CMAKE_HIP_COMPILER_VERSION MATCHES "^[0-9.]+$")
            set(_hip_compiler_version "\"${CMAKE_HIP_COMPILER_VERSION}\"")
        endif()
    endif()
    set(STRIX_BUILD_JSON "{\"format\":\"strix-build\",\"revision\":1,\"status\":\"available\",\"version\":\"${PROJECT_VERSION}\",\"git_sha\":${_sha},\"git_sha_source\":${_sha_source},\"dirty\":${_dirty},\"target_isa\":[${_isas}],\"compiler_id\":${_compiler},\"compiler_version\":${_compiler_version},\"hip_compiler_id\":${_hip_compiler},\"hip_compiler_version\":${_hip_compiler_version},\"cmake_version\":\"${CMAKE_VERSION}\",\"options\":{${_options}},\"flags_evidence\":\"configured\"}")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/strix" "${CMAKE_CURRENT_BINARY_DIR}/share/strix")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/include/strix/build_info.hpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/strix/build_info.hpp" @ONLY)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/share/strix/build-info.json" "${STRIX_BUILD_JSON}\n")
target_include_directories(strix_core PUBLIC "${CMAKE_CURRENT_BINARY_DIR}/generated")
if(TARGET strix-build-info-tests AND NOT STRIX_EMBED_BUILD_INFO)
    target_compile_definitions(strix-build-info-tests PRIVATE STRIX_TEST_BUILD_INFO_OFF=1)
endif()
