#version 450

layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Scale { float w[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform RmsNormParameters {
    uint width;
    uint rows;
    uint use_scale;
    float epsilon;
} params;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= params.rows) return;
    uint base = row * params.width;
    precise float sum = 0.0;
    for (uint i = 0; i < params.width; ++i) sum += x[base + i] * x[base + i];
    float mean = sum / float(params.width) + params.epsilon;
    float inv = (isinf(mean) || isnan(mean)) ? uintBitsToFloat(0x7fc00000u) : 1.0 / sqrt(mean);
    for (uint i = 0; i < params.width; ++i)
        y[base + i] = (x[base + i] * inv) * (params.use_scale != 0u ? w[i] : 1.0);
}
