+config USB4_GPU_STREAM
+	bool "Experimental GPU DMA-BUF stream mode"
+	depends on USB4_STREAM
+	select DMA_SHARED_BUFFER
+	default n
+	help
+	  Adds a project experimental, explicitly selected DMA-BUF mode to
